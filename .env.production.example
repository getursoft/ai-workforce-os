APP_ENV="production"
NODE_ENV="production"
RECEPTIONIST_VOICE_ENABLED="false"
PORT="4000"
DATABASE_URL="postgresql://<user>:<password>@<database-host>:5432/<database>?schema=public&sslmode=require"
WEB_APP_URL="https://<dashboard-host>"
API_PUBLIC_URL="https://<api-host>"
ALLOW_DEVELOPMENT_IMPLEMENTATIONS="false"
ALLOW_LOCALHOST_PRODUCTION="false"
# Single universal platform-owner account (superadmin across every organization).
PLATFORM_OWNER_EMAIL="krpandey25646@gmail.com"
# Public signup is DISABLED in production by default — organizations are only created by the platform owner.
PUBLIC_SIGNUP_ENABLED="false"
JWT_ACCESS_SECRET="<at-least-32-random-bytes>"
JWT_ACCESS_EXPIRES_IN_SECONDS="900"
JWT_ACCESS_ISSUER="ai-workforce-os-api"
JWT_ACCESS_AUDIENCE="ai-workforce-os"
REFRESH_TOKEN_EXPIRES_IN_SECONDS="2592000"
REFRESH_TOKEN_PEPPER="<at-least-32-random-bytes>"
API_KEY_PEPPER="<at-least-32-random-bytes>"
PLUGIN_SECRETS_ENCRYPTION_KEY="<base64-encoded-32-byte-key>"
PASSWORD_HASH_MEMORY_COST="65536"
PASSWORD_HASH_TIME_COST="3"
PASSWORD_HASH_PARALLELISM="1"
COOKIE_SECURE="true"
COOKIE_SAME_SITE="lax"
COOKIE_DOMAIN="<cookie-domain-or-empty>"
LOG_LEVEL="info"
KNOWLEDGE_STORAGE_PATH="/var/lib/ai-workforce-os/knowledge"
KNOWLEDGE_MAX_FILE_SIZE_MB="10"
KNOWLEDGE_CHUNK_TARGET_TOKENS="500"
KNOWLEDGE_CHUNK_OVERLAP_TOKENS="100"
KNOWLEDGE_SEARCH_CANDIDATE_LIMIT="1000"
KNOWLEDGE_SEARCH_DEFAULT_TOP_K="5"
KNOWLEDGE_SEARCH_MAX_TOP_K="10"
KNOWLEDGE_SEARCH_DEFAULT_SCORE_THRESHOLD="0.2"
KNOWLEDGE_RETRIEVAL_DEBUG_LOGGING="false"
