{
  "name": "ai-workforce-os",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.15.4"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm health && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "clean": "turbo run clean && rm -rf .turbo",
    "dev": "turbo run dev",
    "db:migrate": "prisma migrate deploy --schema=database/prisma/schema.prisma",
    "health": "node --experimental-strip-types scripts/health-check.ts",
    "validate:production-config": "pnpm --filter @ai-workforce-os/api build && node apps/api/dist/production/validate-production-config.js",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "prepare": "husky",
    "test:db:prepare": "node --experimental-strip-types scripts/prepare-test-database.ts"
  },
  "prisma": {
    "seed": "node --experimental-strip-types database/prisma/seed.ts"
  },
  "pnpm": {
    "overrides": {
      "glob@>=10.2.0 <10.5.0": "10.5.0",
      "lodash@>=4.0.0 <=4.17.23": "4.18.0",
      "multer@<2.2.0": "2.2.0",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "tmp@<0.2.7": "0.2.7"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "@next/eslint-plugin-next": "^16.2.10",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "prisma": "^6.1.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  }
}
