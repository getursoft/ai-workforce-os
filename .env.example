DATABASE_URL="postgresql://ai_workforce_os:ai_workforce_os@localhost:5432/ai_workforce_os?schema=public"
WEB_APP_URL="http://localhost:3000"
API_PUBLIC_URL="http://localhost:4000"
APP_ENV="development"
NODE_ENV="development"
PORT="4000"
ALLOW_DEVELOPMENT_IMPLEMENTATIONS="true"
ALLOW_LOCALHOST_PRODUCTION="false"
# Single universal platform-owner account (superadmin across every organization). This account is
# seeded by database/prisma/seed.ts (password from PLATFORM_OWNER_PASSWORD, default PlatformOwner@25646).
PLATFORM_OWNER_EMAIL="krpandey25646@gmail.com"
# When false, public self-registration is disabled — organizations are only created by the platform owner.
# Defaults to false in production/staging and true elsewhere (so the test suite can provision orgs).
PUBLIC_SIGNUP_ENABLED="true"
JWT_ACCESS_SECRET="replace-with-at-least-32-random-bytes"
JWT_ACCESS_EXPIRES_IN_SECONDS="900"
JWT_ACCESS_ISSUER="ai-workforce-os-api"
JWT_ACCESS_AUDIENCE="ai-workforce-os"
REFRESH_TOKEN_EXPIRES_IN_SECONDS="2592000"
REFRESH_TOKEN_PEPPER="replace-with-at-least-32-random-bytes"
API_KEY_PEPPER="replace-with-at-least-32-random-bytes"
PLUGIN_SECRETS_ENCRYPTION_KEY="replace-with-base64-encoded-32-byte-key"
PASSWORD_HASH_MEMORY_COST="65536"
PASSWORD_HASH_TIME_COST="3"
PASSWORD_HASH_PARALLELISM="1"
COOKIE_SECURE="false"
COOKIE_SAME_SITE="lax"
COOKIE_DOMAIN=""
KNOWLEDGE_STORAGE_PATH="./storage/knowledge"
KNOWLEDGE_MAX_FILE_SIZE_MB="10"
KNOWLEDGE_CHUNK_TARGET_TOKENS="500"
KNOWLEDGE_CHUNK_OVERLAP_TOKENS="100"
KNOWLEDGE_SEARCH_CANDIDATE_LIMIT="1000"
KNOWLEDGE_SEARCH_DEFAULT_TOP_K="5"
KNOWLEDGE_SEARCH_MAX_TOP_K="10"
KNOWLEDGE_SEARCH_DEFAULT_SCORE_THRESHOLD="0.2"
KNOWLEDGE_RETRIEVAL_DEBUG_LOGGING="false"
