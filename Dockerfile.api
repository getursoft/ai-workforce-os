FROM node:22-alpine AS builder
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json .npmrc ./
COPY apps/api/package.json apps/api/package.json
COPY apps/dashboard/package.json apps/dashboard/package.json
COPY packages ./packages
COPY plugins ./plugins
# database/ must be present before `pnpm install`: the root package.json's postinstall hook runs
# `prisma generate --schema=database/prisma/schema.prisma` automatically on every install (needed for
# Vercel/CI, where the whole repo is already checked out), so the schema has to exist by then here too.
COPY database ./database
RUN pnpm install --frozen-lockfile
COPY apps/api ./apps/api
# Build via Turbo's own dependency graph (`dependsOn: ["^build"]` in turbo.json), not a hand-maintained
# chain of `pnpm --filter` commands: a hand-maintained list silently goes stale whenever apps/api gains a
# new workspace dependency (this is exactly how `@ai-workforce-os/skill-sdk` ended up missing here,
# producing "Cannot find module" at compile time even though it's a declared dependency).
RUN pnpm exec prisma generate --schema=database/prisma/schema.prisma \
  && pnpm exec turbo run build --filter=@ai-workforce-os/api
# Not `pnpm prune --prod`: it has no --filter support in pnpm workspaces and evaluates the whole
# workspace's dependency graph at once, which is unreliable here. Do not reintroduce it without
# switching to the workspace-aware `pnpm deploy` command and verifying the runtime container actually
# starts.

FROM node:22-alpine AS runtime
ENV NODE_ENV=production APP_ENV=production
WORKDIR /workspace
RUN addgroup -S app && adduser -S -G app app
COPY --from=builder --chown=app:app /workspace/node_modules ./node_modules
# pnpm workspaces symlink each project's own dependencies (e.g. @nestjs/*) into that project's own
# node_modules, not just the workspace root's — root node_modules alone only has root devDependencies.
# Omitting this crash-loops the runtime container on "Cannot find module '@nestjs/common'".
COPY --from=builder --chown=app:app /workspace/apps/api/node_modules ./apps/api/node_modules
COPY --from=builder --chown=app:app /workspace/apps/api/dist ./apps/api/dist
COPY --from=builder --chown=app:app /workspace/apps/api/package.json ./apps/api/package.json
COPY --from=builder --chown=app:app /workspace/packages ./packages
COPY --from=builder --chown=app:app /workspace/plugins ./plugins
COPY --from=builder --chown=app:app /workspace/database ./database
USER app
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:4000/health/live').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "apps/api/dist/main.js"]
