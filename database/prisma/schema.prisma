  toolExecution   AgentToolExecution?     @relation(fields: [toolExecutionId], references: [id], onDelete: SetNull)

  @@index([organizationId, conversationId, createdAt])
  @@index([toolExecutionId])
  @@map("conversation_messages")
}

/// A file the user attached to a conversation (text, PDF, Word, JPG/PNG image) so an AI Employee can read
/// its contents. The extracted text is stored on the row and injected into the agent's conversation context
/// on the next run, so the employee can answer from the attachment. WhatsApp channel attachments will use
/// the same model when the channel adapter lands.
model ConversationAttachment {
  id                   String       @id @default(uuid()) @db.Uuid
  organizationId       String       @map("organization_id") @db.Uuid
  pluginInstallationId String       @map("plugin_installation_id") @db.Uuid
  conversationId       String       @map("conversation_id") @db.Uuid
  createdByUserId      String?      @map("created_by_user_id") @db.Uuid
  originalFilename     String       @map("original_filename") @db.VarChar(255)
  mimeType             String       @map("mime_type") @db.VarChar(160)
  sizeBytes            Int          @map("size_bytes")
  storageKey           String       @map("storage_key") @db.VarChar(500)
  extractedText        String       @map("extracted_text") @db.Text
  createdAt            DateTime     @default(now()) @map("created_at")
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pluginInstallation   Plugin       @relation(fields: [pluginInstallationId], references: [id], onDelete: Cascade)
  conversation         Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdBy            User?        @relation("ConversationAttachmentCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, conversationId, createdAt])
  @@map("conversation_attachments")
}

model AgentExecution {
