/// Distinguishes a lead generated for Krevia itself (the platform's own acquisition funnel — website
/// "Book a Demo"/"Contact Us"/etc) from a lead an organization's own AI Employee (e.g. Sales Employee)
/// generates for THAT organization's own customers. `PlatformLead` rows are always PLATFORM — there is
/// no code path that ever writes TENANT here (a tenant's own leads live in SalesLead/TravelLead/etc,
/// each already organization-scoped) — but the value is kept explicit/queryable rather than implied, so
/// the platform-owner API's "only PLATFORM leads" guarantee is a visible WHERE clause, not a structural
/// accident, and so a future genuinely-platform-relevant TENANT-linked lead type has somewhere to go
/// without a schema change.
enum PlatformLeadScope {
  PLATFORM
  TENANT

  @@map("platform_lead_scope")
}

/// Where a platform lead came from. WEBSITE_DEMO/CONTACT_US map to the public marketing site's actual
/// forms (see apps/dashboard/src/app/api/demo, /api/contact); CONTACT_SALES/WEBSITE_ENQUIRY are reserved
/// for future sources that don't exist as real forms yet; OTHER covers anything manually entered.
enum PlatformLeadSource {
  WEBSITE_DEMO
  CONTACT_SALES
  CONTACT_US
  WEBSITE_ENQUIRY
  OTHER

  @@map("platform_lead_source")
}

/// Coarse categorization derived server-side from `source` at creation time (see
