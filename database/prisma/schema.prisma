/// Sprint 4.6 — Multi-Employee Collaboration & Delegation Engine.
enum EmployeeDelegatedTaskStatus {
  CREATED
  VALIDATING
  QUEUED
  RUNNING
  WAITING_FOR_INPUT
  WAITING_FOR_APPROVAL
  COMPLETED
  FAILED
  TIMED_OUT
  CANCELLED
  REJECTED

  @@map("employee_delegated_task_status")
}

/// A structured task one installed AI Employee delegates to another installed AI Employee in the same
/// organization, created and tracked exclusively through WorkforceOrchestratorService. Employee plugin
/// installation references (source/target) are intentionally plain UUID columns, not Prisma relations —
/// the Plugin model is central to the whole system and this table deliberately avoids adding another
/// inbound relation to it; tenancy/status/capability checks are enforced in the orchestrator at every
/// read, not by a database foreign key.
model EmployeeDelegatedTask {
  id                           String                      @id @default(uuid()) @db.Uuid
  organizationId               String                      @map("organization_id") @db.Uuid
  parentExecutionId            String?                     @map("parent_execution_id") @db.Uuid
  parentWorkflowExecutionId    String?                     @map("parent_workflow_execution_id") @db.Uuid
  sourceEmployeeInstallationId String                      @map("source_employee_installation_id") @db.Uuid
  targetEmployeeInstallationId String                      @map("target_employee_installation_id") @db.Uuid
  childConversationId          String?                     @map("child_conversation_id") @db.Uuid
  approvalRequestId            String?                     @map("approval_request_id") @db.Uuid
  requestedByActorType         String                      @default("EMPLOYEE") @map("requested_by_actor_type") @db.VarChar(40)
  requestedByActorId           String?                     @map("requested_by_actor_id") @db.VarChar(200)
  taskType                     String                      @map("task_type") @db.VarChar(80)
  title                        String                      @db.VarChar(300)
  instructions                 String                      @db.Text
  inputPayloadJson             Json                        @default("{}") @map("input_payload_json")
  expectedOutputSchemaJson     Json?                       @map("expected_output_schema_json")
  resultPayloadJson            Json?                       @map("result_payload_json")
  status                       EmployeeDelegatedTaskStatus @default(CREATED)
  priority                     Int                         @default(0)
  idempotencyKey               String?                     @unique @map("idempotency_key") @db.VarChar(500)
  correlationId                String                      @map("correlation_id") @db.VarChar(120)
  causationId                  String?                     @map("causation_id") @db.VarChar(120)
  delegationDepth              Int                         @default(0) @map("delegation_depth")
  delegationChain              Json                        @default("[]") @map("delegation_chain")
  joinPolicy                   String?                     @map("join_policy") @db.VarChar(20)
  mode                         String                      @default("SYNCHRONOUS") @map("mode") @db.VarChar(20)
  attemptCount                 Int                         @default(0) @map("attempt_count")
  maxAttempts                  Int                         @default(1) @map("max_attempts")
  timeoutAt                    DateTime?                   @map("timeout_at")
  startedAt                    DateTime?                   @map("started_at")
  completedAt                  DateTime?                   @map("completed_at")
  failedAt                     DateTime?                   @map("failed_at")
  cancelledAt                  DateTime?                   @map("cancelled_at")
  errorCode                    String?                     @map("error_code") @db.VarChar(100)
  errorMessageSafe             String?                     @map("error_message_safe") @db.VarChar(500)
  createdAt                    DateTime                    @default(now()) @map("created_at")
  updatedAt                    DateTime                    @updatedAt @map("updated_at")
  organization                 Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([sourceEmployeeInstallationId, createdAt])
  @@index([targetEmployeeInstallationId, status])
  @@index([parentWorkflowExecutionId])
  @@index([correlationId])
  @@map("employee_delegated_tasks")
}

/// Sprint 4.6 (continued) — tracks the aggregate join state of a parallel delegation group: N sibling
/// EmployeeDelegatedTask rows share one correlationId; this row is the single, atomically-claimed place
/// that decides "has this group resolved yet" so the parent is resumed exactly once regardless of how many
/// siblings finish concurrently (optimistic `status: PENDING -> RESOLVED` updateMany, same pattern as
/// WorkflowExecutionService's revision-guarded updates).
model EmployeeDelegationJoin {
  id                           String       @id @default(uuid()) @db.Uuid
  organizationId               String       @map("organization_id") @db.Uuid
  correlationId                String       @unique @map("correlation_id") @db.VarChar(120)
  sourceEmployeeInstallationId String       @map("source_employee_installation_id") @db.Uuid
  parentWorkflowExecutionId    String?      @map("parent_workflow_execution_id") @db.Uuid
  joinPolicy                   String       @map("join_policy") @db.VarChar(20)
  minimumRequired              Int?         @map("minimum_required")
  totalChildren                Int          @map("total_children")
  status                       String       @default("PENDING") @map("status") @db.VarChar(20)
  resolvedReason               String?      @map("resolved_reason") @db.VarChar(40)
  resolvedAt                   DateTime?    @map("resolved_at")
  createdAt                    DateTime     @default(now()) @map("created_at")
  updatedAt                    DateTime     @updatedAt @map("updated_at")
  organization                 Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("employee_delegation_joins")
}

/// Sprint 4.6 — one row per organization, created lazily with safe defaults on first read (same lifecycle
/// pattern as OrganizationSetting). Governs whether/how installed employees may delegate to each other.
model WorkforceCollaborationPolicy {
  id                                    String       @id @default(uuid()) @db.Uuid
  organizationId                        String       @unique @map("organization_id") @db.Uuid
  collaborationEnabled                  Boolean      @default(true) @map("collaboration_enabled")
  maximumDelegationDepth                Int          @default(2) @map("maximum_delegation_depth")
  maximumTasksPerParentExecution        Int          @default(10) @map("maximum_tasks_per_parent_execution")
  allowedSourceEmployeeIds              Json         @default("[]") @map("allowed_source_employee_ids")
  allowedTargetEmployeeIds              Json         @default("[]") @map("allowed_target_employee_ids")
  allowedTaskTypes                      Json         @default("[]") @map("allowed_task_types")
  crossEmployeeMemorySharingMode        String       @default("SELECTED_FACTS_ONLY") @map("cross_employee_memory_sharing_mode") @db.VarChar(40)
  requireApprovalForSensitiveDelegation Boolean      @default(true) @map("require_approval_for_sensitive_delegation")
  delegationTimeoutMs                   Int          @default(15000) @map("delegation_timeout_ms")
  retryLimit                            Int          @default(1) @map("retry_limit")
  allowParallelDelegation               Boolean      @default(true) @map("allow_parallel_delegation")
  exposeDelegationToUser                Boolean      @default(true) @map("expose_delegation_to_user")
  createdAt                             DateTime     @default(now()) @map("created_at")
  updatedAt                             DateTime     @updatedAt @map("updated_at")
  organization                          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("workforce_collaboration_policies")
}

