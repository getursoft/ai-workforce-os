/// Organization-level shared AI provider credential: provider type + base URL/endpoint + ONE
/// encrypted credential (AES-256-GCM via PluginSecretsEncryptionService, same convention as
/// PluginAiConfiguration/EmailDeliveryConfiguration). Many AiModelProfile rows reference the same
/// connection so an API key is stored exactly once per organization instead of copied into every
/// employee's own PluginAiConfiguration row. Never put a model name here — a connection is
/// "provider + credentials + endpoint" only; model selection lives on AiModelProfile.
model AiProviderConnection {
  id                      String                     @id @default(uuid()) @db.Uuid
  organizationId          String                     @map("organization_id") @db.Uuid
  name                    String                     @db.VarChar(120)
  providerType            PluginAiProviderType       @map("provider_type")
  baseUrl                 String?                    @map("base_url") @db.VarChar(500)
  encryptedCredentialJson Json                       @map("encrypted_credential_json")
  encryptionVersion       Int                        @default(1) @map("encryption_version")
  status                  AiProviderConnectionStatus @default(ACTIVE)
  isDefault               Boolean                    @default(false) @map("is_default")
  metadataJson            Json                       @default("{}") @map("metadata_json")
  lastHealthCheckAt       DateTime?                  @map("last_health_check_at")
  lastHealthStatus        AiProviderHealthStatus     @default(UNKNOWN) @map("last_health_status")
  createdByUserId         String                     @map("created_by_user_id") @db.Uuid
  createdAt               DateTime                   @default(now()) @map("created_at")
  updatedAt               DateTime                   @updatedAt @map("updated_at")
  organization            Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy               User                       @relation("AiProviderConnectionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  modelProfiles           AiModelProfile[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("ai_provider_connections")
}

/// A reusable, named model configuration (model + purpose + generation settings) referencing exactly
/// one AiProviderConnection. Many profiles may reuse the same connection's credential (e.g. "Standard
/// GPT-4.1" and "Fast Routing" both pointing at the same "OpenAI Production" connection) — profiles
/// never carry their own credential.
model AiModelProfile {
  id                     String                        @id @default(uuid()) @db.Uuid
  organizationId         String                        @map("organization_id") @db.Uuid
  providerConnectionId   String                        @map("provider_connection_id") @db.Uuid
  name                   String                        @db.VarChar(120)
  purpose                AiProfilePurpose              @default(DEFAULT)
  model                  String?                       @db.VarChar(160)
  embeddingModel         String?                       @map("embedding_model") @db.VarChar(160)
  temperature            Decimal?                      @db.Decimal(3, 2)
  maxOutputTokens        Int?                          @map("max_output_tokens")
  timeoutMs              Int?                          @map("timeout_ms")
  additionalSettingsJson Json                          @default("{}") @map("additional_settings_json")
  isDefault              Boolean                       @default(false) @map("is_default")
  isActive               Boolean                       @default(true) @map("is_active")
  createdAt              DateTime                      @default(now()) @map("created_at")
  updatedAt              DateTime                      @updatedAt @map("updated_at")
  organization           Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  providerConnection     AiProviderConnection          @relation(fields: [providerConnectionId], references: [id], onDelete: Restrict)
  employeeAssignments    EmployeeAiProfileAssignment[]
  orgDefaultFor          OrganizationAiDefaults[]      @relation("OrgDefaultProfile")
  orgRoutingDefaultFor   OrganizationAiDefaults[]      @relation("OrgRoutingProfile")
  orgReasoningDefaultFor OrganizationAiDefaults[]      @relation("OrgReasoningProfile")
  orgEmbeddingDefaultFor OrganizationAiDefaults[]      @relation("OrgEmbeddingProfile")

  @@index([organizationId])
  @@index([organizationId, purpose])
  @@index([organizationId, purpose, isDefault])
  @@index([providerConnectionId])
  @@map("ai_model_profiles")
}

/// Which model profile a given employee (plugin installation) should use for a purpose — database-
/// driven, no employee-name conditions anywhere in the resolver. Absence of a row for a given purpose
/// means "fall through to the organization default for that purpose" (see
/// AiConfigurationResolverService's precedence). A DEFAULT-purpose row is the employee's fallback
/// profile for every purpose that has no purpose-specific row of its own.
model EmployeeAiProfileAssignment {
  id                   String           @id @default(uuid()) @db.Uuid
  organizationId       String           @map("organization_id") @db.Uuid
  pluginInstallationId String           @map("plugin_installation_id") @db.Uuid
  modelProfileId       String           @map("model_profile_id") @db.Uuid
  purpose              AiProfilePurpose @default(DEFAULT)
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pluginInstallation   Plugin           @relation(fields: [pluginInstallationId], references: [id], onDelete: Cascade)
  modelProfile         AiModelProfile   @relation(fields: [modelProfileId], references: [id], onDelete: Restrict)

  @@unique([organizationId, pluginInstallationId, purpose])
  @@index([organizationId])
  @@index([modelProfileId])
  @@map("employee_ai_profile_assignments")
}

/// Organization-wide fallback profiles per purpose — consulted after employee-level assignments and
/// before legacy PluginAiConfiguration in AiConfigurationResolverService's precedence. Changing
/// `defaultProfileId` here immediately changes what every employee resolving "Organization Default"
/// (i.e. with no explicit assignment of their own) uses, with no per-employee re-configuration.
model OrganizationAiDefaults {
  id                 String          @id @default(uuid()) @db.Uuid
  organizationId     String          @unique @map("organization_id") @db.Uuid
  defaultProfileId   String?         @map("default_profile_id") @db.Uuid
  routingProfileId   String?         @map("routing_profile_id") @db.Uuid
  reasoningProfileId String?         @map("reasoning_profile_id") @db.Uuid
  embeddingProfileId String?         @map("embedding_profile_id") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  defaultProfile     AiModelProfile? @relation("OrgDefaultProfile", fields: [defaultProfileId], references: [id], onDelete: SetNull)
  routingProfile     AiModelProfile? @relation("OrgRoutingProfile", fields: [routingProfileId], references: [id], onDelete: SetNull)
  reasoningProfile   AiModelProfile? @relation("OrgReasoningProfile", fields: [reasoningProfileId], references: [id], onDelete: SetNull)
  embeddingProfile   AiModelProfile? @relation("OrgEmbeddingProfile", fields: [embeddingProfileId], references: [id], onDelete: SetNull)

  @@map("organization_ai_defaults")
}

/**
 * Per-employee-installation SMTP/email delivery settings (sender address, SMTP host/credentials) —
 * used by EmailService/DeliveryRecorderService to send real ticket emails instead of relying on
 * process-wide SMTP_* env vars. Mirrors PluginAiConfiguration's shape: non-secret fields live in
 * `configuration`, the SMTP password lives only inside `encryptedSecrets` (AES-256-GCM via
 * PluginSecretsEncryptionService), never in a plaintext column.
 */
model EmailDeliveryConfiguration {
  id                   String       @id @default(uuid()) @db.Uuid
  organizationId       String       @map("organization_id") @db.Uuid
  pluginInstallationId String       @unique @map("plugin_installation_id") @db.Uuid
  configuration        Json
  encryptedSecrets     Json         @map("encrypted_secrets")
  encryptionVersion    Int          @default(1) @map("encryption_version")
  updatedBy            String       @map("updated_by") @db.Uuid
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pluginInstallation   Plugin       @relation(fields: [pluginInstallationId], references: [id], onDelete: Cascade)
  updater              User         @relation("EmailDeliveryConfigurationUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@index([organizationId, pluginInstallationId])
  @@map("email_delivery_configurations")
}

model Team {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(120)
  slug           String       @db.VarChar(140)
  description    String?      @db.VarChar(500)
  managerId      String?      @map("manager_id") @db.Uuid
  parentTeamId   String?      @map("parent_team_id") @db.Uuid
  status         TeamStatus   @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  manager        User?        @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  parentTeam     Team?        @relation("TeamHierarchy", fields: [parentTeamId], references: [id], onDelete: SetNull)
  childTeams     Team[]       @relation("TeamHierarchy")
  members        TeamMember[]

  @@unique([organizationId, slug])
  @@index([organizationId, status, deletedAt])
  @@index([managerId])
  @@index([parentTeamId])
  @@map("teams")
}

model TeamMember {
  teamId    String         @map("team_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  role      TeamMemberRole @default(MEMBER)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  team      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model Role {
  id                  String               @id @default(uuid()) @db.Uuid
  organizationId      String               @map("organization_id") @db.Uuid
  name                String               @db.VarChar(80)
  description         String?              @db.VarChar(255)
  isSystem            Boolean              @default(false) @map("is_system")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions         RolePermission[]
  users               UserRole[]
  serviceAccountRoles ServiceAccountRole[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(100)
  description String?          @db.VarChar(255)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model ServiceAccount {
  id              String               @id @default(uuid()) @db.Uuid
  organizationId  String               @map("organization_id") @db.Uuid
  name            String               @db.VarChar(120)
  description     String?              @db.VarChar(500)
  status          ServiceAccountStatus @default(ACTIVE)
  createdByUserId String               @map("created_by_user_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  deletedAt       DateTime?            @map("deleted_at")
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User                 @relation("ServiceAccountCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  apiKeys         ApiKey[]
  roles           ServiceAccountRole[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("service_accounts")
}

model ApiKey {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  serviceAccountId String            @map("service_account_id") @db.Uuid
  name             String            @db.VarChar(120)
  keyPrefix        String            @map("key_prefix") @db.VarChar(16)
  publicId         String            @unique @map("public_id") @db.VarChar(32)
  maskedValue      String            @map("masked_value") @db.VarChar(80)
  secretHash       String            @map("secret_hash") @db.Char(64)
  hashVersion      Int               @default(1) @map("hash_version")
  environment      ApiKeyEnvironment
  status           ApiKeyStatus      @default(ACTIVE)
  expiresAt        DateTime?         @map("expires_at")
  lastUsedAt       DateTime?         @map("last_used_at")
  revokedAt        DateTime?         @map("revoked_at")
  createdByUserId  String            @map("created_by_user_id") @db.Uuid
  revokedByUserId  String?           @map("revoked_by_user_id") @db.Uuid
  replacementKeyId String?           @unique @map("replacement_key_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  serviceAccount   ServiceAccount    @relation(fields: [serviceAccountId], references: [id], onDelete: Cascade)
  createdBy        User              @relation("ApiKeyCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  revokedBy        User?             @relation("ApiKeyRevoker", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  replacementKey   ApiKey?           @relation("ApiKeyRotation", fields: [replacementKeyId], references: [id], onDelete: SetNull)
  replaces         ApiKey?           @relation("ApiKeyRotation")

  @@index([publicId])
  @@index([organizationId, status])
  @@index([serviceAccountId])
  @@map("api_keys")
}

model ServiceAccountRole {
  serviceAccountId String         @map("service_account_id") @db.Uuid
  roleId           String         @map("role_id") @db.Uuid
  assignedAt       DateTime       @default(now()) @map("assigned_at")
  serviceAccount   ServiceAccount @relation(fields: [serviceAccountId], references: [id], onDelete: Cascade)
  role             Role           @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([serviceAccountId, roleId])
  @@index([roleId])
  @@map("service_account_roles")
}

model Invitation {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  email           String       @db.VarChar(320)
  normalizedEmail String       @map("normalized_email") @db.VarChar(320)
  tokenHash       String       @unique @map("token_hash") @db.Char(64)
  roleIds         Json         @map("role_ids")
  invitedById     String       @map("invited_by_id") @db.Uuid
  expiresAt       DateTime     @map("expires_at")
  acceptedAt      DateTime?    @map("accepted_at")
  revokedAt       DateTime?    @map("revoked_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy       User         @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([organizationId, normalizedEmail])
  @@index([expiresAt])
  @@map("invitations")
}

model AuthenticationSession {
  id                   String                 @id @default(uuid()) @db.Uuid
  userId               String                 @map("user_id") @db.Uuid
  /// The organization this session is currently operating as. Null means the user's home organization
  /// (the organization their User row belongs to). Set only for platform-owner org-switch sessions so a
  /// token refresh keeps operating in the switched organization instead of reverting to the home org.
  activeOrganizationId String?                @map("active_organization_id") @db.Uuid
  tokenHash            String                 @map("token_hash") @db.VarChar(128)
  familyId             String                 @map("family_id") @db.Uuid
  expiresAt            DateTime               @map("expires_at")
  revokedAt            DateTime?              @map("revoked_at")
  replacedBySessionId  String?                @unique @map("replaced_by_session_id") @db.Uuid
  lastUsedAt           DateTime?              @map("last_used_at")
  ipAddress            String?                @map("ip_address") @db.VarChar(64)
  userAgent            String?                @map("user_agent") @db.VarChar(512)
  createdAt            DateTime               @default(now()) @map("created_at")
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization   Organization?          @relation("SessionActiveOrganization", fields: [activeOrganizationId], references: [id], onDelete: SetNull)
  replacedBy           AuthenticationSession? @relation("SessionReplacement", fields: [replacedBySessionId], references: [id], onDelete: SetNull)
  replaces             AuthenticationSession? @relation("SessionReplacement")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@index([userId, revokedAt])
  @@map("authentication_sessions")
}

/// One-time, short-lived password-reset tokens for the "forgot password" flow. The raw token is never
/// stored — only its SHA-256 hash, matching the invitation-token convention.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model ConnectorDefinition {
  id                   String                    @id @default(uuid()) @db.Uuid
  key                  String                    @unique @db.VarChar(100)
  name                 String                    @db.VarChar(160)
  description          String                    @db.VarChar(1000)
  category             String                    @db.VarChar(80)
  version              String                    @db.VarChar(50)
  authType             ConnectorAuthType         @map("auth_type")
  manifest             Json
  declaredCapabilities Json                      @map("declared_capabilities")
  configurationSchema  Json                      @map("configuration_schema")
  credentialSchema     Json                      @map("credential_schema")
  status               ConnectorDefinitionStatus @default(ACTIVE)
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")
  tools                ConnectorTool[]
  installations        ConnectorInstallation[]

  @@index([status, category])
  @@map("connector_definitions")
}

model ConnectorTool {
  id                 String                 @id @default(uuid()) @db.Uuid
  connectorId        String                 @map("connector_id") @db.Uuid
  name               String                 @db.VarChar(120)
  displayName        String                 @map("display_name") @db.VarChar(160)
  description        String                 @db.VarChar(1000)
  inputSchema        Json                   @map("input_schema")
  outputSchema       Json?                  @map("output_schema")
  requiredCapability String                 @map("required_capability") @db.VarChar(120)
  operationType      ConnectorOperationType @map("operation_type")
  riskLevel          ConnectorRiskLevel     @map("risk_level")
  timeoutMs          Int                    @default(10000) @map("timeout_ms")
  enabled            Boolean                @default(true)
  connector          ConnectorDefinition    @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@unique([connectorId, name])
  @@index([connectorId, enabled])
  @@map("connector_tools")
}

model ConnectorInstallation {
  id                   String                      @id @default(uuid()) @db.Uuid
  organizationId       String                      @map("organization_id") @db.Uuid
  connectorId          String                      @map("connector_id") @db.Uuid
  displayName          String                      @map("display_name") @db.VarChar(160)
  status               ConnectorInstallationStatus @default(DRAFT)
  configuration        Json                        @default("{}")
  encryptedCredentials Json                        @map("encrypted_credentials")
  credentialMetadata   Json                        @default("{}") @map("credential_metadata")
  grantedCapabilities  Json                        @default("[]") @map("granted_capabilities")
  lastHealthStatus     ConnectorHealthStatus       @default(UNKNOWN) @map("last_health_status")
  lastHealthCheckedAt  DateTime?                   @map("last_health_checked_at")
  lastErrorCode        String?                     @map("last_error_code") @db.VarChar(100)
  lastErrorMessage     String?                     @map("last_error_message") @db.VarChar(500)
  credentialExpiresAt  DateTime?                   @map("credential_expires_at")
  createdByUserId      String                      @map("created_by_user_id") @db.Uuid
  createdAt            DateTime                    @default(now()) @map("created_at")
  updatedAt            DateTime                    @updatedAt @map("updated_at")
  deletedAt            DateTime?                   @map("deleted_at")
  organization         Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connector            ConnectorDefinition         @relation(fields: [connectorId], references: [id], onDelete: Restrict)
  createdBy            User                        @relation("ConnectorInstallationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  executions           ConnectorExecution[]
  events               ConnectorEvent[]
  auditEvents          ConnectorAuditEvent[]
  dummyCrmLeads        DummyCrmLead[]

  @@index([organizationId, status, deletedAt])
  @@index([organizationId, connectorId])
  @@map("connector_installations")
}

model ConnectorExecution {
  id                      String                   @id @default(uuid()) @db.Uuid
  organizationId          String                   @map("organization_id") @db.Uuid
  connectorInstallationId String                   @map("connector_installation_id") @db.Uuid
  agentExecutionId        String?                  @map("agent_execution_id") @db.Uuid
  toolName                String                   @map("tool_name") @db.VarChar(180)
  actorType               ConnectorActorType       @map("actor_type")
  actorId                 String?                  @map("actor_id") @db.Uuid
  requestMetadata         Json                     @default("{}") @map("request_metadata")
  input                   Json
  output                  Json?
  status                  ConnectorExecutionStatus @default(RUNNING)
  latencyMs               Int?                     @map("latency_ms")
  externalStatusCode      Int?                     @map("external_status_code")
  errorCode               String?                  @map("error_code") @db.VarChar(100)
  errorMessage            String?                  @map("error_message") @db.VarChar(500)
  createdAt               DateTime                 @default(now()) @map("created_at")
  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectorInstallation   ConnectorInstallation    @relation(fields: [connectorInstallationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([connectorInstallationId, createdAt])
  @@index([agentExecutionId])
  @@map("connector_executions")
}

model ConnectorEvent {
  id                      String                @id @default(uuid()) @db.Uuid
  organizationId          String                @map("organization_id") @db.Uuid
  connectorInstallationId String                @map("connector_installation_id") @db.Uuid
  eventType               String                @map("event_type") @db.VarChar(120)
  externalEventId         String                @map("external_event_id") @db.VarChar(255)
  payload                 Json
  status                  ConnectorEventStatus  @default(RECEIVED)
  receivedAt              DateTime              @default(now()) @map("received_at")
  processedAt             DateTime?             @map("processed_at")
  errorCode               String?               @map("error_code") @db.VarChar(100)
  errorMessage            String?               @map("error_message") @db.VarChar(500)
  organization            Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectorInstallation   ConnectorInstallation @relation(fields: [connectorInstallationId], references: [id], onDelete: Cascade)

  @@unique([connectorInstallationId, externalEventId])
  @@index([organizationId, receivedAt])
  @@index([connectorInstallationId, status])
  @@map("connector_events")
}

model ConnectorAuditEvent {
  id                      String                 @id @default(uuid()) @db.Uuid
  organizationId          String                 @map("organization_id") @db.Uuid
  connectorInstallationId String?                @map("connector_installation_id") @db.Uuid
  userId                  String?                @map("user_id") @db.Uuid
  event                   String                 @db.VarChar(120)
  requestId               String                 @map("request_id") @db.VarChar(100)
  metadata                Json                   @default("{}")
  createdAt               DateTime               @default(now()) @map("created_at")
  organization            Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectorInstallation   ConnectorInstallation? @relation(fields: [connectorInstallationId], references: [id], onDelete: SetNull)
  user                    User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([connectorInstallationId, createdAt])
  @@map("connector_audit_events")
}

model DummyCrmLead {
  id                      String                @id @default(uuid()) @db.Uuid
  organizationId          String                @map("organization_id") @db.Uuid
  connectorInstallationId String                @map("connector_installation_id") @db.Uuid
  firstName               String?               @map("first_name") @db.VarChar(100)
  lastName                String?               @map("last_name") @db.VarChar(100)
  phone                   String?               @db.VarChar(40)
  email                   String?               @db.VarChar(320)
  source                  String                @db.VarChar(100)
  interest                String?               @db.VarChar(255)
  notes                   String?               @db.Text
  metadata                Json                  @default("{}")
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")
  organization            Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectorInstallation   ConnectorInstallation @relation(fields: [connectorInstallationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([connectorInstallationId])
  @@map("dummy_crm_leads")
}

model ChannelConnection {
  id                               String                  @id @default(uuid()) @db.Uuid
  organizationId                   String                  @map("organization_id") @db.Uuid
  pluginInstallationId             String                  @map("plugin_installation_id") @db.Uuid
  name                             String                  @db.VarChar(160)
  provider                         ChannelProvider
  channelType                      ChannelType             @map("channel_type")
  status                           ChannelConnectionStatus @default(DRAFT)
  configuration                    Json                    @default("{}")
  encryptedSecrets                 Json                    @map("encrypted_secrets")
  secretMetadata                   Json                    @default("{}") @map("secret_metadata")
  /// Meta Cloud API: WhatsApp Business Account ID
  whatsappBusinessAccountId        String?                 @map("whatsapp_business_account_id") @db.VarChar(100)
  /// Meta Cloud API: phone number ID for this connection
  phoneNumberId                    String?                 @unique @map("phone_number_id") @db.VarChar(100)
  /// Meta Cloud API: display phone number in E.164 format
  displayPhoneNumber               String?                 @map("display_phone_number") @db.VarChar(24)
  /// The plugin/employee this channel is assigned to
  assignedAgentId                  String?                 @map("assigned_agent_id") @db.Uuid
  /// Meta Embedded Signup or manual
  onboardingMode                   String?                 @default("MANUAL") @map("onboarding_mode") @db.VarChar(24)
  /// Token expiry timestamp for Meta access tokens
  tokenExpiresAt                   DateTime?               @map("token_expires_at")
  /// When the last webhook was received
  lastWebhookReceivedAt            DateTime?               @map("last_webhook_received_at")
  /// FIXED = single employee, INTENT_ROUTER = multi-employee receptionist
  routingMode                      String?                 @default("FIXED") @map("routing_mode") @db.VarChar(24)
  /// Default employee for FIXED mode
  defaultEmployeeId                String?                 @map("default_employee_id") @db.Uuid
  /// Employees permitted for routing (JSON array of plugin IDs)
  allowedEmployeeIds               Json                    @default("[]") @map("allowed_employee_ids")
  /// Customisable receptionist greeting
  receptionistGreeting             String?                 @map("receptionist_greeting") @db.VarChar(500)
  /// Customisable intent question
  intentQuestion                   String?                 @map("intent_question") @db.VarChar(500)
  /// Message when request is out of scope
  outOfScopeMessage                String?                 @map("out_of_scope_message") @db.VarChar(500)
  /// Message when intent is unclear
  ambiguousIntentMessage           String?                 @map("ambiguous_intent_message") @db.VarChar(500)
  /// Send processing acknowledgement after successful routing
  processingAcknowledgementEnabled Boolean?                @default(true) @map("processing_acknowledgement_enabled")
  /// Custom processing acknowledgement text
  processingAcknowledgementMessage String?                 @map("processing_acknowledgement_message") @db.VarChar(500)
  /// ALWAYS_AFTER_ROUTING, ONLY_FOR_SLOW_OPERATIONS, DISABLED
  processingAcknowledgementMode    String?                 @default("ALWAYS_AFTER_ROUTING") @map("processing_acknowledgement_mode") @db.VarChar(32)
  lastTestedAt                     DateTime?               @map("last_tested_at")
  lastTestStatus                   String?                 @map("last_test_status") @db.VarChar(32)
  lastErrorCode                    String?                 @map("last_error_code") @db.VarChar(100)
  lastErrorMessage                 String?                 @map("last_error_message") @db.VarChar(500)
  createdByUserId                  String                  @map("created_by_user_id") @db.Uuid
  createdAt                        DateTime                @default(now()) @map("created_at")
  updatedAt                        DateTime                @updatedAt @map("updated_at")
  deletedAt                        DateTime?               @map("deleted_at")
  organization                     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pluginInstallation               Plugin                  @relation(fields: [pluginInstallationId], references: [id], onDelete: Restrict)
  createdBy                        User                    @relation("ChannelConnectionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  conversations                    Conversation[]
  messages                         ChannelMessage[]

  @@index([organizationId, status, deletedAt])
  @@index([organizationId, provider, channelType])
  @@index([organizationId, whatsappBusinessAccountId])
  @@map("channel_connections")
}

model ChannelMessage {
  id                  String                  @id @default(uuid()) @db.Uuid
  organizationId      String                  @map("organization_id") @db.Uuid
  channelConnectionId String                  @map("channel_connection_id") @db.Uuid
  conversationId      String?                 @map("conversation_id") @db.Uuid
  agentExecutionId    String?                 @map("agent_execution_id") @db.Uuid
  provider            ChannelProvider
  direction           ChannelMessageDirection
  status              ChannelMessageStatus    @default(RECEIVED)
  providerMessageSid  String?                 @map("provider_message_sid") @db.VarChar(100)
  fromAddress         String                  @map("from_address") @db.VarChar(64)
  toAddress           String                  @map("to_address") @db.VarChar(64)
  body                String?                 @db.Text
  mediaMetadata       Json                    @default("[]") @map("media_metadata")
  errorCode           String?                 @map("error_code") @db.VarChar(100)
  errorMessage        String?                 @map("error_message") @db.VarChar(500)
  processingAttempts  Int                     @default(0) @map("processing_attempts")
  nextAttemptAt       DateTime?               @map("next_attempt_at")
  receivedAt          DateTime?               @map("received_at")
  sentAt              DateTime?               @map("sent_at")
  /// Sprint 4.7: the ExecutionTrace.traceId this channel message belongs to — plain scalar, no FK.
  traceId             String?                 @map("trace_id") @db.VarChar(64)
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")
  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channelConnection   ChannelConnection       @relation(fields: [channelConnectionId], references: [id], onDelete: Cascade)
  conversation        Conversation?           @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@unique([channelConnectionId, providerMessageSid])
  @@index([organizationId, channelConnectionId, createdAt])
  @@index([organizationId, status])
  @@index([conversationId])
  @@index([status, nextAttemptAt])
  @@index([organizationId, traceId])
  @@map("channel_messages")
}

model EmployeeRoutingProfile {
