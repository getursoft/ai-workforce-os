  createdAt                             DateTime                               @default(now()) @map("created_at")
  updatedAt                             DateTime                               @updatedAt @map("updated_at")
  users                                 User[]
  settings                              OrganizationSetting?
  roles                                 Role[]
  invitations                           Invitation[]
  teams                                 Team[]
  serviceAccounts                       ServiceAccount[]
  plugins                               Plugin[]
  pluginConfigurations                  PluginConfiguration[]
  conversations                         Conversation[]
  agentExecutions                       AgentExecution[]
  agentToolExecutions                   AgentToolExecution[]
  agentMemories                         AgentMemory[]
  pluginAiConfigurations                PluginAiConfiguration[]
  emailDeliveryConfigurations           EmailDeliveryConfiguration[]
  connectorInstallations                ConnectorInstallation[]
  connectorExecutions                   ConnectorExecution[]
  connectorEvents                       ConnectorEvent[]
  connectorAuditEvents                  ConnectorAuditEvent[]
  dummyCrmLeads                         DummyCrmLead[]
  knowledgeCollections                  KnowledgeCollection[]
  knowledgeDocuments                    KnowledgeDocument[]
  knowledgeChunks                       KnowledgeChunk[]
  channelConnections                    ChannelConnection[]
  channelMessages                       ChannelMessage[]
  travelEmployeeConfigurations          TravelEmployeeConfiguration[]
  customerProfiles                      CustomerProfile[]
  travelLeads                           TravelLead[]
  skillExecutions                       SkillExecution[]
  workflowExecutions                    WorkflowExecution[]
  approvalRequests                      ApprovalRequest[]
  employeeRoutingProfiles               EmployeeRoutingProfile[]
  usageEvents                           UsageEvent[]
  creditPurchaseOrders                  CreditPurchaseOrder[]
  paymentGatewayConfigurations          PaymentGatewayConfiguration[]
  approvalPolicies                      ApprovalPolicy[]
  approvalAuditEvents                   ApprovalAuditEvent[]
  travelBookings                        TravelBooking[]
  travelCancellations                   TravelCancellation[]
  hrLeaveRequests                       HrLeaveRequest[]
  hrEmployeeConfigurations              HrEmployeeConfiguration[]
  hrTickets                             HrTicket[]
  financeEmployeeConfigurations         FinanceEmployeeConfiguration[]
  financeRecords                        FinanceRecord[]
  itSupportEmployeeConfigurations       ItSupportEmployeeConfiguration[]
  itSupportTickets                      ItSupportTicket[]
  salesEmployeeConfigurations           SalesEmployeeConfiguration[]
  salesLeads                            SalesLead[]
  marketingEmployeeConfigurations       MarketingEmployeeConfiguration[]
  marketingCampaigns                    MarketingCampaign[]
  legalEmployeeConfigurations           LegalEmployeeConfiguration[]
  legalNotices                          LegalNotice[]
  customerSupportEmployeeConfigurations CustomerSupportEmployeeConfiguration[]
  customerSupportTickets                CustomerSupportTicket[]
  conversationAttachments               ConversationAttachment[]
  legalDocuments                        LegalDocument[]
  subscription                          OrganisationSubscription?
  memoryRecords                         MemoryRecord[]
  memoryAuditEvents                     MemoryAuditEvent[]
  conversationSummaries                 ConversationSummary[]
  sessionsActingIn                      AuthenticationSession[]                @relation("SessionActiveOrganization")
