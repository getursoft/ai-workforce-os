/// Sprint 4.5: a single persistent memory record in the platform Memory Service. This is a SEPARATE
/// capability from Knowledge (RAG), Conversation history, and the legacy AgentMemory conversation-state
/// blobs — it never replaces or duplicates any of those. Every AI Employee benefits automatically because
/// the shared AgentService run loop reads these records through MemoryService and injects them into every
/// prompt. Scopes: USER (an individual user's durable facts), EMPLOYEE (an AI Employee's working memory),
/// ORGANIZATION (shared org knowledge, admins edit, everyone reads), CONVERSATION (summarized history).
/// Rows are hard-tenant-scoped by organizationId; every query in MemoryService filters by it before
/// anything else, so a memory can never leak across tenants.
model MemoryRecord {
  id                  String                       @id @default(uuid()) @db.Uuid
  organizationId      String                       @map("organization_id") @db.Uuid
  /// The AI Employee (Plugin installation) this memory belongs to — null for org-wide/global records.
  employeeId          String?                      @map("employee_id") @db.Uuid
  /// The user this memory belongs to — null for employee/organization/global records.
  userId              String?                      @map("user_id") @db.Uuid
  /// The conversation this memory was captured from — null for non-conversation scopes.
  conversationId      String?                      @map("conversation_id") @db.Uuid
  scope               MemoryScope
  /// Coarse grouping (e.g. "PREFERENCE", "TRAVEL", "CONTACT", "WORKFLOW", "SUMMARY").
  category            String                       @db.VarChar(80)
  /// Stable, reusable lookup key (e.g. "food.preference", "preferred.airline", "conversation.summary").
  key                 String                       @db.VarChar(160)
  value               Json
  searchableText      String?                      @map("searchable_text") @db.Text
  /// Extraction/recall confidence in [0,1].
  confidence          Decimal                      @default(1) @map("confidence") @db.Decimal(4, 3)
  importance          MemoryImportance             @default(MEDIUM)
  source              MemorySource                 @default(DASHBOARD)
  metadata            Json                         @default("{}")
  /// Fixed-width pgvector embedding (1536) written/read via raw SQL — identical convention to
  /// KnowledgeChunk.embedding (see docs/enterprise-knowledge.md). Optional: memories saved without an
  /// embedding are still exact/keyword searchable and still surface in ranked recall.
  embedding           Unsupported("vector(1536)")?
  embeddingModel      String?                      @map("embedding_model") @db.VarChar(160)
  embeddingDimensions Int?                         @map("embedding_dimensions")
  /// When set, the memory is eligible for automatic expiry (memory decay).
  expiresAt           DateTime?                    @map("expires_at")
  createdAt           DateTime                     @default(now()) @map("created_at")
  updatedAt           DateTime                     @updatedAt @map("updated_at")
  deletedAt           DateTime?                    @map("deleted_at")
  organization        Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee            Plugin?                      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  user                User?                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation        Conversation?                @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  auditEvents         MemoryAuditEvent[]

  @@index([organizationId, scope, deletedAt])
  @@index([organizationId, employeeId, scope, deletedAt])
  @@index([organizationId, userId, scope, deletedAt])
  @@index([organizationId, conversationId, scope, deletedAt])
  @@index([organizationId, category, key, deletedAt])
  @@index([organizationId, updatedAt])
  @@map("memory_records")
}

/// Durable, tenant-scoped audit trail for memory operations. Every remember/update/forget/expire/recall/
/// search on a memory record writes an event here so "who changed what memory, when" is never lost.
model MemoryAuditEvent {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  /// The authenticated user/service account that performed the action (null for system-triggered jobs).
  actorId        String?           @map("actor_id") @db.Uuid
  memoryId       String            @map("memory_id") @db.Uuid
  action         MemoryAuditAction
  scope          MemoryScope
  key            String            @db.VarChar(160)
  category       String            @db.VarChar(80)
  changeSummary  String?           @map("change_summary") @db.VarChar(500)
  metadata       Json              @default("{}")
  createdAt      DateTime          @default(now()) @map("created_at")
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memory         MemoryRecord      @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([organizationId, memoryId])
  @@index([organizationId, createdAt])
  @@map("memory_audit_events")
}

/// Sprint 4.5: the rolling, summarized history of a conversation. The platform keeps every message row
/// (so the dashboard conversation view and execution auditing stay intact) but the prompt injection only
/// ever uses this summary plus the last N raw messages — that is what prevents token explosion on long
/// conversations. Updated automatically every `summarizeInterval` turns by MemoryService.summarizeConversation.
model ConversationSummary {
  id                     String       @id @default(uuid()) @db.Uuid
  organizationId         String       @map("organization_id") @db.Uuid
  conversationId         String       @unique @map("conversation_id") @db.Uuid
  summary                String       @db.Text
  /// Number of conversation messages covered by this summary when it was last written.
  summarizedMessageCount Int          @map("summarized_message_count")
  summaryVersion         Int          @default(1) @map("summary_version")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation           Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([organizationId, updatedAt])
  @@map("conversation_summaries")
}

/// Sprint 4.7: one row per correlated end-to-end request (a chat turn, an async delegation, a channel
/// webhook) — the root of one execution tree. Additive, unified observability layer: does not replace or
/// duplicate AgentExecution/WorkflowExecution/EmployeeDelegatedTask/UsageEvent/AuditEvent, it correlates
/// them via traceId (a plain scalar carried by those tables, not a foreign key) so retention here never
/// restricts deleting/pruning those business records.
model ExecutionTrace {
  id                  String       @id @default(uuid()) @db.Uuid
  organizationId      String       @map("organization_id") @db.Uuid
  traceId             String       @unique @map("trace_id") @db.VarChar(64)
  rootSpanId          String       @map("root_span_id") @db.VarChar(64)
  parentTraceId       String?      @map("parent_trace_id") @db.VarChar(64)
  conversationId      String?      @map("conversation_id") @db.Uuid
  agentExecutionId    String?      @map("agent_execution_id") @db.Uuid
  workflowExecutionId String?      @map("workflow_execution_id") @db.Uuid
  delegatedTaskId     String?      @map("delegated_task_id") @db.Uuid
  channelConnectionId String?      @map("channel_connection_id") @db.Uuid
  actorType           String       @map("actor_type") @db.VarChar(40)
  actorId             String?      @map("actor_id") @db.VarChar(200)
  status              String       @default("RUNNING") @db.VarChar(20)
  startedAt           DateTime     @default(now()) @map("started_at")
  completedAt         DateTime?    @map("completed_at")
  durationMs          Int?         @map("duration_ms")
  errorCode           String?      @map("error_code") @db.VarChar(100)
  errorMessageSafe    String?      @map("error_message_safe") @db.VarChar(500)
  /// Sanitized-only (see ObservabilitySanitizer) — never raw prompts, secrets, tokens or full documents.
  metadataJson        Json         @default("{}") @map("metadata_json")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, startedAt])
  @@index([organizationId, status])
  @@index([organizationId, conversationId])
  @@index([agentExecutionId])
  @@index([workflowExecutionId])
  @@index([delegatedTaskId])
  @@map("execution_traces")
}

/// Sprint 4.7: one node in an ExecutionTrace's span tree. Linked to its trace by traceId (string, not a
/// Prisma relation) so span writes never need to load the trace row first — keeps span-creation overhead
/// low (Phase 23) and lets spans be written even if the trace row write is still in flight.
model ExecutionSpan {
  id                     String       @id @default(uuid()) @db.Uuid
  organizationId         String       @map("organization_id") @db.Uuid
  traceId                String       @map("trace_id") @db.VarChar(64)
  spanId                 String       @unique @map("span_id") @db.VarChar(64)
  parentSpanId           String?      @map("parent_span_id") @db.VarChar(64)
  name                   String       @db.VarChar(160)
  spanType               String       @map("span_type") @db.VarChar(40)
  component              String       @db.VarChar(80)
  employeeInstallationId String?      @map("employee_installation_id") @db.Uuid
  workflowExecutionId    String?      @map("workflow_execution_id") @db.Uuid
  delegatedTaskId        String?      @map("delegated_task_id") @db.Uuid
  status                 String       @default("RUNNING") @db.VarChar(20)
  startedAt              DateTime     @default(now()) @map("started_at")
  completedAt            DateTime?    @map("completed_at")
  durationMs             Int?         @map("duration_ms")
  /// Sanitized-only summaries (counts, IDs, safe scalars) — never raw prompts/documents/secrets.
  inputSummaryJson       Json?        @map("input_summary_json")
  outputSummaryJson      Json?        @map("output_summary_json")
  errorCode              String?      @map("error_code") @db.VarChar(100)
  errorMessageSafe       String?      @map("error_message_safe") @db.VarChar(500)
  attributesJson         Json?        @map("attributes_json")
  createdAt              DateTime     @default(now()) @map("created_at")
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, traceId])
  @@index([organizationId, spanType, startedAt])
  @@index([organizationId, status])
  @@index([parentSpanId])
  @@map("execution_spans")
}

/// Sprint 4.7 Phase 16: an in-app operational alert derived from trace/span/task/workflow state on read
/// (no external PagerDuty/Slack integration). Deduplicated per (organizationId, ruleCode, relatedEntity)
/// at the service layer so a repeatedly-detected condition updates one row instead of spawning duplicates.
model ObservabilityAlert {
  id                   String       @id @default(uuid()) @db.Uuid
  organizationId       String       @map("organization_id") @db.Uuid
  ruleCode             String       @map("rule_code") @db.VarChar(60)
  severity             String       @default("WARNING") @db.VarChar(20)
  status               String       @default("OPEN") @db.VarChar(20)
  title                String       @db.VarChar(200)
  detailsJson          Json         @default("{}") @map("details_json")
  relatedTraceId       String?      @map("related_trace_id") @db.VarChar(64)
  relatedEntityType    String?      @map("related_entity_type") @db.VarChar(40)
  relatedEntityId      String?      @map("related_entity_id") @db.VarChar(200)
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  acknowledgedAt       DateTime?    @map("acknowledged_at")
  acknowledgedByUserId String?      @map("acknowledged_by_user_id") @db.Uuid
  resolvedAt           DateTime?    @map("resolved_at")
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([organizationId, ruleCode, relatedEntityType, relatedEntityId])
  @@map("observability_alerts")
}

/// Sprint 4.7 Phase 15: per-organization tracing sampling/retention configuration. One row per
/// organization, upserted lazily the same way WorkforceCollaborationPolicy is.
model ObservabilitySettings {
  id                         String       @id @default(uuid()) @db.Uuid
  organizationId             String       @unique @map("organization_id") @db.Uuid
  tracingEnabled             Boolean      @default(true) @map("tracing_enabled")
  sampleRate                 Float        @default(1.0) @map("sample_rate")
  errorTraceRetentionDays    Int          @default(30) @map("error_trace_retention_days")
  successTraceRetentionDays  Int          @default(7) @map("success_trace_retention_days")
  includeSafeInputSummaries  Boolean      @default(true) @map("include_safe_input_summaries")
  includeSafeOutputSummaries Boolean      @default(true) @map("include_safe_output_summaries")
  providerDetailVisible      Boolean      @default(true) @map("provider_detail_visible")
  toolDetailVisible          Boolean      @default(true) @map("tool_detail_visible")
  createdAt                  DateTime     @default(now()) @map("created_at")
  updatedAt                  DateTime     @updatedAt @map("updated_at")
  organization               Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("observability_settings")
}

// ============================================================================
// Sprint 4.8 — Autonomous Scheduler & Background Execution Engine
// ============================================================================

/// Sprint 4.8: the code-level catalog of executable background jobs. One row per `key`, shared across
/// every organization (an org never owns a definition — it installs *schedules* for a definition). The
/// built-in catalog is seeded lazily by SchedulerService.onModuleInit; plugin authors extend the platform
/// by registering handlers in the JobRegistry, not by writing engine code.
model JobDefinition {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(120)
  name        String   @db.VarChar(200)
  description String   @default("") @db.VarChar(500)
  /// Domain grouping — TRAVEL, HR, FINANCE, LEGAL, SALES, PLATFORM, WORKFLOW, CHANNEL, ...
  category    String   @default("PLATFORM") @db.VarChar(60)
  /// What the handler does when the job runs. SEND_REMINDER, START_WORKFLOW, REQUEST_APPROVAL,
  /// PUBLISH_EVENT, RUN_AGENT, ESCALATE_APPROVAL, PENDING_APPROVAL_SCAN are the built-ins.
  handlerType String   @map("handler_type") @db.VarChar(60)
  /// The default retry policy: IMMEDIATE, 30_SEC, 2_MIN, 5_MIN, 30_MIN, 2_HOUR, 24_HOUR, NONE.
  retryPolicy String   @default("5_MIN") @map("retry_policy") @db.VarChar(20)
  maxRetry    Int      @default(5) @map("max_retry")
  timeoutMs   Int      @default(30000) @map("timeout_ms")
  /// The event name that triggers this definition when triggerType is EVENT/AFTER_* (e.g. booking.approved).
  eventName   String?  @map("event_name") @db.VarChar(120)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([category, enabled])
  @@map("job_definitions")
}

/// Sprint 4.8: reusable schedule blueprints. Global templates (organizationId null) ship with the
/// platform; an organization can copy a template into its own org-scoped row and customize it. Instantiating
/// a template creates an ACTIVE ScheduledJob.
model JobTemplate {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String?                 @map("organization_id") @db.Uuid
  name           String                  @db.VarChar(200)
  description    String                  @default("") @db.VarChar(500)
  definitionKey  String                  @map("definition_key") @db.VarChar(120)
  triggerType    ScheduledJobTriggerType @map("trigger_type")
  cronExpression String?                 @map("cron_expression") @db.VarChar(120)
  intervalMs     Int?                    @map("interval_ms")
  timezone       String                  @default("UTC") @db.VarChar(64)
  priority       ScheduledJobPriority    @default(NORMAL)
  maxRetry       Int                     @default(5) @map("max_retry")
  timeoutMs      Int                     @default(30000) @map("timeout_ms")
  payload        Json                    @default("{}")
  createdBy      String?                 @map("created_by") @db.Uuid
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  organization   Organization?           @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, definitionKey])
  @@map("job_templates")
}

/// Sprint 4.8: one durable schedule. `dedupeKey` (nullable, unique) makes ONE_TIME / AFTER_* schedules
/// idempotent — scheduling the same logical reminder twice collapses onto the same row, so a job never
/// runs twice because of a duplicated event. `nextRun` decides dispatch eligibility; one-time jobs are
/// marked COMPLETED after their single run, recurring jobs keep advancing `nextRun`.
model ScheduledJob {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  /// The AI Employee (Plugin installation) the job belongs to — null for platform/organization jobs.
  employeeId     String?                 @map("employee_id") @db.Uuid
  workflowId     String?                 @map("workflow_id") @db.Uuid
  definitionKey  String                  @map("definition_key") @db.VarChar(120)
  triggerType    ScheduledJobTriggerType @map("trigger_type")
  cronExpression String?                 @map("cron_expression") @db.VarChar(120)
  intervalMs     Int?                    @map("interval_ms")
  timezone       String                  @default("UTC") @db.VarChar(64)
  status         ScheduledJobStatus      @default(ACTIVE)
  priority       ScheduledJobPriority    @default(NORMAL)
  nextRun        DateTime?               @map("next_run")
  lastRun        DateTime?               @map("last_run")
  retryCount     Int                     @default(0) @map("retry_count")
  maxRetry       Int                     @default(5) @map("max_retry")
  timeoutMs      Int                     @default(30000) @map("timeout_ms")
  payload        Json                    @default("{}")
  context        Json                    @default("{}")
  dedupeKey      String?                 @unique @map("dedupe_key") @db.VarChar(500)
  pausedAt       DateTime?               @map("paused_at")
  pausedBy       String?                 @map("paused_by") @db.Uuid
  cancelledAt    DateTime?               @map("cancelled_at")
  cancelledBy    String?                 @map("cancelled_by") @db.Uuid
  createdBy      String?                 @map("created_by") @db.Uuid
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee       Plugin?                 @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  executions     ScheduledExecution[]

  @@index([organizationId, status, nextRun])
  @@index([organizationId, triggerType, status])
  @@index([organizationId, employeeId])
  @@map("scheduled_jobs")
}

/// Sprint 4.8: one run of a ScheduledJob — the audit trail of every execution, exactly-once per run.
/// `dedupeKey` (nullable, unique) is set from `jobId:attempt:scheduledFor` so a concurrent worker can never
/// create two executions for the same attempt. `traceId` is the Sprint 4.7 ExecutionTrace this run spans.
model ScheduledExecution {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  jobId          String                   @map("job_id") @db.Uuid
  employeeId     String?                  @map("employee_id") @db.Uuid
  definitionKey  String                   @map("definition_key") @db.VarChar(120)
  triggerType    ScheduledJobTriggerType  @map("trigger_type")
  priority       ScheduledJobPriority     @default(NORMAL)
  status         ScheduledExecutionStatus @default(QUEUED)
  scheduledFor   DateTime                 @map("scheduled_for")
  attemptCount   Int                      @default(1) @map("attempt_count")
  startedAt      DateTime?                @map("started_at")
  completedAt    DateTime?                @map("completed_at")
  durationMs     Int?                     @map("duration_ms")
  nextAttemptAt  DateTime?                @map("next_attempt_at")
  traceId        String?                  @map("trace_id") @db.VarChar(64)
  workerId       String?                  @map("worker_id") @db.VarChar(100)
  result         Json?                    @default("{}")
  errorCode      String?                  @map("error_code") @db.VarChar(100)
  errorMessage   String?                  @map("error_message") @db.VarChar(1000)
  tokens         Int                      @default(0)
  credits        Int                      @default(0)
  createdBy      String?                  @map("created_by") @db.Uuid
  dedupeKey      String?                  @unique @map("dedupe_key") @db.VarChar(600)
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job            ScheduledJob             @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, scheduledFor])
  @@index([organizationId, jobId, createdAt])
  @@index([organizationId, status, priority])
  @@index([organizationId, traceId])
  @@index([status, nextAttemptAt])
  @@map("scheduled_executions")
}

/// Sprint 4.8: per-job distributed lock. Exactly one row per ScheduledJob (unique jobId); a worker acquires
/// it with an atomic `version` guard (optimistic locking) and a short `leaseExpiresAt`. A crashed worker's
/// lock is stolen by any worker after the lease expires — that is the crash-recovery mechanism.
model JobLock {
  id             String       @id @default(uuid()) @db.Uuid
  jobId          String       @unique @map("job_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  workerId       String       @map("worker_id") @db.VarChar(100)
  version        Int          @default(0)
  lockedAt       DateTime     @default(now()) @map("locked_at")
  leaseExpiresAt DateTime     @map("lease_expires_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, leaseExpiresAt])
  @@map("job_locks")
}

// ============================================================================
// Sprint 5.0 — Production hardening infrastructure
// ============================================================================

/// Sprint 5.0: lifecycle of one durable queue message. The database is the authoritative state; a queue
/// adapter (Postgres-backed today, Redis/BullMQ as a deploy-time option) claims rows with an atomic
/// status transition and a visibility timeout so a crashed worker's work is re-claimed after the lease.
enum QueueMessageStatus {
  QUEUED
  CLAIMED
  COMPLETED
  FAILED
  RETRYING
  DEAD_LETTERED

  @@map("queue_message_status")
}

/// Sprint 5.0: the logical queues the durable queue adapter serves. Existing pollers (scheduler,
/// workforce processor, channel processor) map onto these categories; new work can publish directly.
enum QueueCategory {
  SCHEDULER_JOBS
  WORKFORCE_TASKS
  CHANNEL_MESSAGES
  DELIVERY_RETRIES
  RETENTION_JOBS
  NOTIFICATION_JOBS
  DOCUMENT_PROCESSING

  @@map("queue_category")
}

/// Sprint 5.0: one durable work item. `refType`/`refId` reference the authoritative business row
/// (booking, delegated task, channel message, scheduled job, ...) — the message is never the only source
/// of truth. `dedupeKey` (unique) makes enqueue idempotent; `availableAt` is the visibility/lease window;
/// `nextAttemptAt` schedules retries with backoff; `maxAttempts` bounds the ladder then the message is
/// parked on the dead-letter state.
model QueueMessage {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  category       QueueCategory      @map("category")
  refType        String             @map("ref_type") @db.VarChar(80)
  refId          String             @map("ref_id") @db.VarChar(200)
  /// Optional employee (Plugin installation) the work belongs to — for tenant-scoped worker fan-out.
  employeeId     String?            @map("employee_id") @db.Uuid
  priority       Int                @default(0)
  status         QueueMessageStatus @default(QUEUED)
  payload        Json               @default("{}")
  availableAt    DateTime           @default(now()) @map("available_at")
  attemptCount   Int                @default(0) @map("attempt_count")
  maxAttempts    Int                @default(5) @map("max_attempts")
  nextAttemptAt  DateTime?          @map("next_attempt_at")
  visibilityMs   Int                @default(60000) @map("visibility_ms")
  workerId       String?            @map("worker_id") @db.VarChar(100)
  traceId        String?            @map("trace_id") @db.VarChar(64)
  dedupeKey      String?            @unique @map("dedupe_key") @db.VarChar(600)
  errorCode      String?            @map("error_code") @db.VarChar(100)
  errorMessage   String?            @map("error_message") @db.VarChar(1000)
  completedAt    DateTime?          @map("completed_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, availableAt, priority])
  @@index([organizationId, status, category])
  @@index([category, status])
  @@index([organizationId, traceId])
  @@map("queue_messages")
}

/// Sprint 5.0: a tenant-aware feature flag. Scope PLATFORM/ENVIRONMENT flags are configured by operators;
/// ORGANIZATION flags override for one tenant. Flags control rollout, never authorization — RBAC and
/// entitlements remain authoritative.
model FeatureFlag {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  key            String        @db.VarChar(120)
  enabled        Boolean       @default(false)
  value          Json          @default("{}")
  description    String?       @db.VarChar(500)
  createdBy      String?       @map("created_by") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("feature_flags")
}

/// Sprint 5.0: per-organization data-retention policy. Tenants configure retention within the platform
/// minimum/maximum bounds (enforced by RetentionService). Null = inherit the platform default.
model DataRetentionPolicy {
  id                     String       @id @default(uuid()) @db.Uuid
  organizationId         String       @unique @map("organization_id") @db.Uuid
  conversationDays       Int?         @map("conversation_days")
  uploadDays             Int?         @map("upload_days")
  traceDays              Int?         @map("trace_days")
  memoryDays             Int?         @map("memory_days")
  schedulerExecutionDays Int?         @map("scheduler_execution_days")
  channelMessageDays     Int?         @map("channel_message_days")
  legalHold              Boolean      @default(false) @map("legal_hold")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("data_retention_policies")
}

/// Sprint 5.0: platform-operator support notes attached to a tenant for the admin/support console. Never
/// stores customer content, prompts, memory values or secrets — only operator-authored operational notes.
model PlatformSupportNote {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  authorUserId   String       @map("author_user_id") @db.Uuid
  body           String       @db.Text
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("platform_support_notes")
}

// ============================================================================
// Sprint 6.1 — Universal Skills Platform
// ============================================================================
// Reusable, versioned, installable platform capabilities. Distinct from the AI Employee/plugin
// (a customer-facing domain worker), from a Tool (a low-level executable capability) and from a
// Workflow (a durable multi-step process). Skills complement those systems — they never replace them.

enum SkillVisibility {
  PUBLIC
  PRIVATE
  ORG_ONLY

  @@map("skill_visibility")
}

enum SkillVersionStatus {
  DRAFT
  PUBLISHED
  DEPRECATED
  RETIRED

  @@map("skill_version_status")
}

enum SkillInstallationStatus {
  INSTALLED
  ENABLED
  DISABLED
  FAILED
  UNINSTALLED

  @@map("skill_installation_status")
}

enum SkillRunStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  TIMEOUT
  CANCELLED

  @@map("skill_run_status")
}

enum SkillBillingCategory {
  DETERMINISTIC
  CPU_INTENSIVE
  AI_PROVIDER_BACKED
  EXTERNAL_PROVIDER_BACKED
  STORAGE_HEAVY

  @@map("skill_billing_category")
}

/// A marketplace skill. `key` is the stable identity; versions live in SkillVersion. The row is
/// authoritative for marketplace/install state; the SkillManifest code in the adapter is authoritative
/// for built-in adapter behavior.
model Skill {
  id            String          @id @default(uuid()) @db.Uuid
  key           String          @unique @db.VarChar(160)
  name          String          @db.VarChar(200)
  description   String          @db.VarChar(2000)
  category      String          @db.VarChar(100)
  author        String          @db.VarChar(160)
  visibility    SkillVisibility @default(PUBLIC)
  icon          String?         @db.VarChar(500)
  latestVersion String          @db.VarChar(50)
  isActive      Boolean         @default(true)
  metadataJson  Json            @default("{}") @map("metadata_json")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  deletedAt     DateTime?       @map("deleted_at")
  versions      SkillVersion[]

  @@index([category])
  @@index([isActive, deletedAt])
  @@map("skills")
}

/// One published version of a skill: the manifest, input/output/configuration JSON schemas, declared
/// permissions/capabilities and dependencies. Executions must preserve the exact version used.
model SkillVersion {
  id                       String               @id @default(uuid()) @db.Uuid
  skillId                  String               @map("skill_id") @db.Uuid
  version                  String               @db.VarChar(50)
  manifestJson             Json                 @map("manifest_json")
  inputSchemaJson          Json                 @map("input_schema_json")
  outputSchemaJson         Json                 @map("output_schema_json")
  configurationSchemaJson  Json?                @map("configuration_schema_json")
  requiredPermissionsJson  Json                 @default("[]") @map("required_permissions_json")
  requiredCapabilitiesJson Json                 @default("[]") @map("required_capabilities_json")
  dependencyManifestJson   Json?                @map("dependency_manifest_json")
  billingCategory          SkillBillingCategory @default(DETERMINISTIC)
  runtimeType              String               @default("BUILT_IN") @db.VarChar(40)
  status                   SkillVersionStatus   @default(PUBLISHED)
  publishedAt              DateTime?            @map("published_at")
  deprecatedAt             DateTime?            @map("deprecated_at")
  createdAt                DateTime             @default(now()) @map("created_at")
  skill                    Skill                @relation(fields: [skillId], references: [id], onDelete: Cascade)
  installations            SkillInstallation[]
  dependencies             SkillDependency[]

  @@unique([skillId, version])
  @@index([skillId, status])
  @@index([skillId, status, version])
  @@map("skill_versions")
}

/// An organization-level installation of a specific skill version. Configuration is stored here
/// (never raw uploaded file bytes). `enabled` gates every execution; grants gate per-employee use.
model SkillInstallation {
  id                String                  @id @default(uuid()) @db.Uuid
  organizationId    String                  @map("organization_id") @db.Uuid
  skillVersionId    String                  @map("skill_version_id") @db.Uuid
  status            SkillInstallationStatus @default(INSTALLED)
  configurationJson Json                    @default("{}") @map("configuration_json")
  installedByUserId String                  @map("installed_by_user_id") @db.Uuid
  enabled           Boolean                 @default(false)
  installedAt       DateTime                @default(now()) @map("installed_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")
  deletedAt         DateTime?               @map("deleted_at")
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  skillVersion      SkillVersion            @relation(fields: [skillVersionId], references: [id], onDelete: Restrict)
  installedBy       User                    @relation(fields: [installedByUserId], references: [id], onDelete: Restrict)
  grants            EmployeeSkillGrant[]
  executions        SkillRun[]

  @@unique([organizationId, skillVersionId])
  @@index([organizationId, enabled, deletedAt])
  @@index([organizationId, deletedAt])
  @@index([skillVersionId])
  @@map("skill_installations")
}

/// Per-employee grant linking an installed skill to an installed AI Employee (Plugin installation).
/// Every query is organization-scoped; cross-tenant grants are structurally impossible.
model EmployeeSkillGrant {
  id                        String            @id @default(uuid()) @db.Uuid
  organizationId            String            @map("organization_id") @db.Uuid
  pluginInstallationId      String            @map("plugin_installation_id") @db.Uuid
  skillInstallationId       String            @map("skill_installation_id") @db.Uuid
  enabled                   Boolean           @default(true)
  configurationOverrideJson Json?             @map("configuration_override_json")
  grantedByUserId           String            @map("granted_by_user_id") @db.Uuid
  createdAt                 DateTime          @default(now()) @map("created_at")
  updatedAt                 DateTime          @updatedAt @map("updated_at")
  organization              Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pluginInstallation        Plugin            @relation(fields: [pluginInstallationId], references: [id], onDelete: Cascade)
  skillInstallation         SkillInstallation @relation(fields: [skillInstallationId], references: [id], onDelete: Cascade)
  grantedBy                 User              @relation(fields: [grantedByUserId], references: [id], onDelete: Restrict)

  @@unique([organizationId, pluginInstallationId, skillInstallationId])
  @@index([organizationId, skillInstallationId])
  @@index([organizationId, pluginInstallationId, enabled])
  @@map("employee_skill_grants")
}

/// One invocation of a skill. Distinct from the pre-existing travel plan-trip SkillExecution mirror
/// (a durable multi-turn state lifecycle); this records a single execution with usage/billing/trace
/// data and an idempotency key. Never stores raw documents or secrets — only safe summaries.
model SkillRun {
  id                     String                       @id @default(uuid()) @db.Uuid
  organizationId         String                       @map("organization_id") @db.Uuid
  skillInstallationId    String                       @map("skill_installation_id") @db.Uuid
  pluginInstallationId   String?                      @map("plugin_installation_id") @db.Uuid
  agentExecutionId       String?                      @map("agent_execution_id") @db.Uuid
  workflowExecutionId    String?                      @map("workflow_execution_id") @db.Uuid
  conversationId         String?                      @map("conversation_id") @db.Uuid
  traceId                String?                      @map("trace_id") @db.VarChar(64)
  idempotencyKey         String                       @map("idempotency_key") @db.VarChar(300)
  skillKey               String                       @map("skill_key") @db.VarChar(160)
  skillVersion           String                       @map("skill_version") @db.VarChar(50)
  status                 SkillRunStatus               @default(RUNNING)
  inputSummaryJson       Json                         @default("{}") @map("input_summary_json")
  outputSummaryJson      Json?                        @map("output_summary_json")
  durationMs             Int                          @default(0) @map("duration_ms")
  inputTokens            Int                          @default(0) @map("input_tokens")
  outputTokens           Int                          @default(0) @map("output_tokens")
  totalTokens            Int                          @default(0) @map("total_tokens")
  creditsConsumed        Int                          @default(0) @map("credits_consumed")
  retryCount             Int                          @default(0) @map("retry_count")
  errorCode              String?                      @map("error_code") @db.VarChar(100)
  errorMessageSafe       String?                      @map("error_message_safe") @db.VarChar(500)
  startedAt              DateTime                     @default(now()) @map("started_at")
  completedAt            DateTime?                    @map("completed_at")
  createdAt              DateTime                     @default(now()) @map("created_at")
  organization           Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  skillInstallation      SkillInstallation            @relation(fields: [skillInstallationId], references: [id], onDelete: Restrict)
  pluginInstallation     Plugin?                      @relation(fields: [pluginInstallationId], references: [id], onDelete: SetNull)
  agentExecution         AgentExecution?              @relation(fields: [agentExecutionId], references: [id], onDelete: SetNull)
  workflowExecution      WorkflowExecution?           @relation(fields: [workflowExecutionId], references: [id], onDelete: SetNull)
  conversation           Conversation?                @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  pipelineNodeExecutions SkillPipelineNodeExecution[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, skillInstallationId, createdAt])
  @@index([organizationId, pluginInstallationId, createdAt])
  @@index([organizationId, traceId])
  @@map("skill_runs")
}

/// Declares a version-to-version dependency between skills (e.g. invoice-parser -> document-reader).
model SkillDependency {
  id                 String       @id @default(uuid()) @db.Uuid
  skillVersionId     String       @map("skill_version_id") @db.Uuid
  dependencySkillKey String       @map("dependency_skill_key") @db.VarChar(160)
  versionConstraint  String       @db.VarChar(80)
  required           Boolean      @default(true)
  createdAt          DateTime     @default(now()) @map("created_at")
  skillVersion       SkillVersion @relation(fields: [skillVersionId], references: [id], onDelete: Cascade)

  @@unique([skillVersionId, dependencySkillKey])
  @@map("skill_dependencies")
}

// ------------------------------------------------------------------------------------------------
// Sprint 6.1B — Skills Platform Enterprise Completion. Purely additive: skill chaining (pipelines),
// packs, and templates. Every node/pack-item/template-item execution still goes through the existing
// SkillsRuntimeService/SkillInstallationService — nothing here bypasses installation, grants, RBAC,
// billing, observability or audit.
// ------------------------------------------------------------------------------------------------

enum SkillPipelineNodeFailureMode {
  STOP
  CONTINUE

  @@map("skill_pipeline_node_failure_mode")
}

enum SkillPipelineExecutionStatus {
  RUNNING
  COMPLETED
  FAILED
  PARTIAL

  @@map("skill_pipeline_execution_status")
}

enum SkillPipelineNodeExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED

  @@map("skill_pipeline_node_execution_status")
}

enum SkillPackInstallationStatus {
  INSTALLED
  PARTIAL
  UNINSTALLED

  @@map("skill_pack_installation_status")
}

/// A reusable, organization-owned chain of skill executions (Skill Chaining Engine, Feature 1).
model SkillPipeline {
  id              String                   @id @default(uuid()) @db.Uuid
  organizationId  String                   @map("organization_id") @db.Uuid
  name            String                   @db.VarChar(200)
  description     String                   @db.VarChar(2000)
  isActive        Boolean                  @default(true) @map("is_active")
  createdByUserId String                   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  deletedAt       DateTime?                @map("deleted_at")
  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User                     @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  nodes           SkillPipelineNode[]
  executions      SkillPipelineExecution[]

  @@index([organizationId, deletedAt])
  @@map("skill_pipelines")
}

/// One step of a SkillPipeline. `onFailure` controls whether a failed node stops the pipeline or lets
/// it continue; `conditionExpression` is a tiny, safe (non-eval) boolean expression evaluated against
/// the previous node's output before this node runs. Every node still executes through
/// SkillsRuntimeService.execute() — the pipeline engine never calls a skill adapter directly.
model SkillPipelineNode {
  id                  String                       @id @default(uuid()) @db.Uuid
  skillPipelineId     String                       @map("skill_pipeline_id") @db.Uuid
  order               Int
  skillKey            String                       @map("skill_key") @db.VarChar(160)
  versionConstraint   String?                      @map("version_constraint") @db.VarChar(80)
  conditionExpression String?                      @map("condition_expression") @db.VarChar(500)
  onFailure           SkillPipelineNodeFailureMode @default(STOP) @map("on_failure")
  timeoutMs           Int?                         @map("timeout_ms")
  maxRetries          Int                          @default(0) @map("max_retries")
  inputMappingJson    Json?                        @map("input_mapping_json")
  createdAt           DateTime                     @default(now()) @map("created_at")
  skillPipeline       SkillPipeline                @relation(fields: [skillPipelineId], references: [id], onDelete: Cascade)

  @@unique([skillPipelineId, order])
  @@map("skill_pipeline_nodes")
}

/// One run of a SkillPipeline — the execution graph root. Node-level detail lives in
/// SkillPipelineNodeExecution; each node's actual skill invocation is a real, separately billed and
/// traced SkillRun row (see SkillPipelineNodeExecution.skillRunId).
model SkillPipelineExecution {
  id                   String                       @id @default(uuid()) @db.Uuid
  organizationId       String                       @map("organization_id") @db.Uuid
  skillPipelineId      String                       @map("skill_pipeline_id") @db.Uuid
  pluginInstallationId String?                      @map("plugin_installation_id") @db.Uuid
  status               SkillPipelineExecutionStatus @default(RUNNING)
  traceId              String?                      @map("trace_id") @db.VarChar(64)
  triggerInputJson     Json                         @default("{}") @map("trigger_input_json")
  startedAt            DateTime                     @default(now()) @map("started_at")
  completedAt          DateTime?                    @map("completed_at")
  durationMs           Int                          @default(0) @map("duration_ms")
  createdAt            DateTime                     @default(now()) @map("created_at")
  organization         Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  skillPipeline        SkillPipeline                @relation(fields: [skillPipelineId], references: [id], onDelete: Cascade)
  pluginInstallation   Plugin?                      @relation(fields: [pluginInstallationId], references: [id], onDelete: SetNull)
  nodeExecutions       SkillPipelineNodeExecution[]

  @@index([organizationId, skillPipelineId, createdAt])
  @@index([organizationId, pluginInstallationId, createdAt])
  @@map("skill_pipeline_executions")
}

/// Per-node status/timing within one pipeline execution — the data the dashboard's execution-graph
/// (DAG) view renders (Feature 7). `skillRunId` links to the real SkillRun once the node actually
/// executes; null while PENDING or when SKIPPED by a condition/prior STOP failure.
model SkillPipelineNodeExecution {
  id                       String                           @id @default(uuid()) @db.Uuid
  skillPipelineExecutionId String                           @map("skill_pipeline_execution_id") @db.Uuid
  skillPipelineNodeId      String                           @map("skill_pipeline_node_id") @db.Uuid
  order                    Int
  skillKey                 String                           @map("skill_key") @db.VarChar(160)
  status                   SkillPipelineNodeExecutionStatus @default(PENDING)
  skillRunId               String?                          @map("skill_run_id") @db.Uuid
  retryCount               Int                              @default(0) @map("retry_count")
  errorCode                String?                          @map("error_code") @db.VarChar(100)
  errorMessageSafe         String?                          @map("error_message_safe") @db.VarChar(500)
  startedAt                DateTime?                        @map("started_at")
  completedAt              DateTime?                        @map("completed_at")
  durationMs               Int                              @default(0) @map("duration_ms")
  createdAt                DateTime                         @default(now()) @map("created_at")
  skillPipelineExecution   SkillPipelineExecution           @relation(fields: [skillPipelineExecutionId], references: [id], onDelete: Cascade)
  skillRun                 SkillRun?                        @relation(fields: [skillRunId], references: [id], onDelete: SetNull)

  @@index([skillPipelineExecutionId, order])
  @@map("skill_pipeline_node_executions")
}

/// A curated, versioned bundle of skills (Skill Packs, Feature 5). Installing a pack installs every
/// listed skill that isn't already installed for the organization, via the existing
/// SkillInstallationService.install — dependency order is resolved through the DependencyResolver.
model SkillPack {
  id            String                  @id @default(uuid()) @db.Uuid
  key           String                  @unique @db.VarChar(160)
  name          String                  @db.VarChar(200)
  description   String                  @db.VarChar(2000)
  category      String                  @db.VarChar(100)
  industry      String?                 @db.VarChar(100)
  author        String                  @db.VarChar(160)
  icon          String?                 @db.VarChar(500)
  version       String                  @db.VarChar(50)
  isActive      Boolean                 @default(true) @map("is_active")
  metadataJson  Json                    @default("{}") @map("metadata_json")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")
  deletedAt     DateTime?               @map("deleted_at")
  items         SkillPackItem[]
  installations SkillPackInstallation[]

  @@index([category])
  @@map("skill_packs")
}

model SkillPackItem {
  id                String    @id @default(uuid()) @db.Uuid
  skillPackId       String    @map("skill_pack_id") @db.Uuid
  skillKey          String    @map("skill_key") @db.VarChar(160)
  versionConstraint String    @default("*") @map("version_constraint") @db.VarChar(80)
  required          Boolean   @default(true)
  order             Int
  createdAt         DateTime  @default(now()) @map("created_at")
  skillPack         SkillPack @relation(fields: [skillPackId], references: [id], onDelete: Cascade)

  @@unique([skillPackId, skillKey])
  @@map("skill_pack_items")
}

/// Tracks that an organization has installed a pack as a unit (dashboard "Update Pack"/"Remove Pack").
/// The actual SkillInstallation rows created are the source of truth for what's runnable; this row is
/// bookkeeping for pack-level provenance and status, not a parallel authorization mechanism.
model SkillPackInstallation {
  id                String                      @id @default(uuid()) @db.Uuid
  organizationId    String                      @map("organization_id") @db.Uuid
  skillPackId       String                      @map("skill_pack_id") @db.Uuid
  packVersion       String                      @map("pack_version") @db.VarChar(50)
  status            SkillPackInstallationStatus @default(INSTALLED)
  installedByUserId String                      @map("installed_by_user_id") @db.Uuid
  installedAt       DateTime                    @default(now()) @map("installed_at")
  updatedAt         DateTime                    @updatedAt @map("updated_at")
  deletedAt         DateTime?                   @map("deleted_at")
  organization      Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  skillPack         SkillPack                   @relation(fields: [skillPackId], references: [id], onDelete: Restrict)
  installedBy       User                        @relation(fields: [installedByUserId], references: [id], onDelete: Restrict)

  @@unique([organizationId, skillPackId])
  @@index([organizationId, deletedAt])
  @@map("skill_pack_installations")
}

/// A reusable business template bundling skills + default configuration for a specific employee type
/// (Skill Templates, Feature 6). Installing a template installs its skills and grants them to a target
/// employee (existing or newly created via the existing PluginService.install) — this table never
/// re-implements employee creation or the workflow engine; `workflowRef` is purely informational.
model SkillTemplate {
  id             String                      @id @default(uuid()) @db.Uuid
  key            String                      @unique @db.VarChar(160)
  name           String                      @db.VarChar(200)
  description    String                      @db.VarChar(2000)
  category       String                      @db.VarChar(100)
  industry       String?                     @db.VarChar(100)
  author         String                      @db.VarChar(160)
  icon           String?                     @db.VarChar(500)
  targetPluginId String                      @map("target_plugin_id") @db.VarChar(160)
  workflowRef    String?                     @map("workflow_ref") @db.VarChar(160)
  version        String                      @db.VarChar(50)
  isActive       Boolean                     @default(true) @map("is_active")
  metadataJson   Json                        @default("{}") @map("metadata_json")
  createdAt      DateTime                    @default(now()) @map("created_at")
  updatedAt      DateTime                    @updatedAt @map("updated_at")
  deletedAt      DateTime?                   @map("deleted_at")
  items          SkillTemplateItem[]
  installations  SkillTemplateInstallation[]

  @@index([category])
  @@map("skill_templates")
}

model SkillTemplateItem {
  id                       String        @id @default(uuid()) @db.Uuid
  skillTemplateId          String        @map("skill_template_id") @db.Uuid
  skillKey                 String        @map("skill_key") @db.VarChar(160)
  versionConstraint        String        @default("*") @map("version_constraint") @db.VarChar(80)
  order                    Int
  defaultConfigurationJson Json          @default("{}") @map("default_configuration_json")
  createdAt                DateTime      @default(now()) @map("created_at")
  skillTemplate            SkillTemplate @relation(fields: [skillTemplateId], references: [id], onDelete: Cascade)

  @@unique([skillTemplateId, skillKey])
  @@map("skill_template_items")
}

model SkillTemplateInstallation {
  id                   String        @id @default(uuid()) @db.Uuid
  organizationId       String        @map("organization_id") @db.Uuid
  skillTemplateId      String        @map("skill_template_id") @db.Uuid
  pluginInstallationId String        @map("plugin_installation_id") @db.Uuid
  installedByUserId    String        @map("installed_by_user_id") @db.Uuid
  installedAt          DateTime      @default(now()) @map("installed_at")
  organization         Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  skillTemplate        SkillTemplate @relation(fields: [skillTemplateId], references: [id], onDelete: Restrict)
  pluginInstallation   Plugin        @relation(fields: [pluginInstallationId], references: [id], onDelete: Cascade)
  installedBy          User          @relation(fields: [installedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, skillTemplateId])
  @@index([organizationId, pluginInstallationId])
  @@map("skill_template_installations")
}
