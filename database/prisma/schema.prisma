model Conversation {
  id                     String                   @id @default(uuid()) @db.Uuid
  organizationId         String                   @map("organization_id") @db.Uuid
  pluginInstallationId   String                   @map("plugin_installation_id") @db.Uuid
  createdByUserId        String?                  @map("created_by_user_id") @db.Uuid
  channelConnectionId    String?                  @map("channel_connection_id") @db.Uuid
  externalUserId         String?                  @map("external_user_id") @db.VarChar(64)
  /// The customer this conversation belongs to, resolved via the CustomerIdentityService. Null means
  /// the customer identity was anonymous/unknown for this conversation (e.g. a fresh dashboard test run
  /// or a first-contact visitor) — distinct from `createdByUserId`, which is the staff member who ran it.
  customerProfileId      String?                  @map("customer_profile_id") @db.Uuid
  title                  String                   @db.VarChar(160)
  status                 ConversationStatus       @default(ACTIVE)
  metadata               Json                     @default("{}")
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")
  deletedAt              DateTime?                @map("deleted_at")
  organization           Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pluginInstallation     Plugin                   @relation(fields: [pluginInstallationId], references: [id], onDelete: Restrict)
  createdBy              User?                    @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  channelConnection      ChannelConnection?       @relation(fields: [channelConnectionId], references: [id], onDelete: Cascade)
  customerProfile        CustomerProfile?         @relation(fields: [customerProfileId], references: [id], onDelete: SetNull)
  messages               ConversationMessage[]
  executions             AgentExecution[]
  memories               AgentMemory[]
  channelMessages        ChannelMessage[]
  travelLeads            TravelLead[]
  skillExecutions        SkillExecution[]
  workflowExecutions     WorkflowExecution[]
  travelBookings         TravelBooking[]
  hrTickets              HrTicket[]
  financeRecords         FinanceRecord[]
  itSupportTickets       ItSupportTicket[]
  salesLeads             SalesLead[]
  marketingCampaigns     MarketingCampaign[]
  legalNotices           LegalNotice[]
  customerSupportTickets CustomerSupportTicket[]
  attachments            ConversationAttachment[]
  legalDocuments         LegalDocument[]
  memoryRecords          MemoryRecord[]
  conversationSummaries  ConversationSummary[]

  @@index([organizationId, status, updatedAt])
  @@index([organizationId, pluginInstallationId])
  @@index([organizationId, channelConnectionId, externalUserId, status])
  @@index([organizationId, customerProfileId])
  @@map("conversations")
}

/// A customer's durable identity and profile — independent of any single Conversation. One customer
/// (a WhatsApp phone number, a CRM record, or a future logged-in portal user) may have many
/// conversations over time, each starting with a clean ConversationMemory/TripState, but all of them
/// resolving back to this same profile so returning customers can be recognized ("Welcome back Krishna")
/// without conversations leaking context into one another. Reusable by any AI Employee, not just Travel.
model CustomerProfile {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  identityType   CustomerIdentityType @map("identity_type")
  /// The identity's natural key within its type: E.164 phone number for PHONE, CRM record id for
  /// CRM_ID, portal user id for PORTAL_USER. Never populated for ANONYMOUS (those aren't persisted).
  externalId     String               @map("external_id") @db.VarChar(160)
  displayName    String?              @map("display_name") @db.VarChar(160)
  preferences    Json                 @default("{}")
  currency       String?              @db.VarChar(8)
  language       String?              @db.VarChar(16)
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  deletedAt      DateTime?            @map("deleted_at")
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations  Conversation[]

  @@unique([organizationId, identityType, externalId])
  @@index([organizationId, identityType])
  @@map("customer_profiles")
}

model ConversationMessage {
  id              String                  @id @default(uuid()) @db.Uuid
  conversationId  String                  @map("conversation_id") @db.Uuid
  organizationId  String                  @map("organization_id") @db.Uuid
