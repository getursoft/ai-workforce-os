  normalizedEmail                              String                                 @unique @map("normalized_email") @db.VarChar(320)
  passwordHash                                 String                                 @map("password_hash") @db.VarChar(255)
  role                                         LegacyUserRole
  status                                       UserStatus
  lastLoginAt                                  DateTime?                              @map("last_login_at")
  createdAt                                    DateTime                               @default(now()) @map("created_at")
  updatedAt                                    DateTime                               @updatedAt @map("updated_at")
  organization                                 Organization                           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sessions                                     AuthenticationSession[]
  userRoles                                    UserRole[]
  invitationsSent                              Invitation[]                           @relation("InvitationSender")
  managedTeams                                 Team[]                                 @relation("TeamManager")
  teamMemberships                              TeamMember[]
  serviceAccountsCreated                       ServiceAccount[]                       @relation("ServiceAccountCreator")
  apiKeysCreated                               ApiKey[]                               @relation("ApiKeyCreator")
  apiKeysRevoked                               ApiKey[]                               @relation("ApiKeyRevoker")
  pluginConfigurationsUpdated                  PluginConfiguration[]                  @relation("PluginConfigurationUpdater")
  conversationsCreated                         Conversation[]
  agentExecutions                              AgentExecution[]
  agentMemories                                AgentMemory[]
  pluginAiConfigurationsUpdated                PluginAiConfiguration[]                @relation("PluginAiConfigurationUpdater")
  emailDeliveryConfigurationsUpdated           EmailDeliveryConfiguration[]           @relation("EmailDeliveryConfigurationUpdater")
  creditPurchaseOrdersCreated                  CreditPurchaseOrder[]
  paymentGatewayConfigurationsUpdated          PaymentGatewayConfiguration[]          @relation("PaymentGatewayConfigurationUpdater")
  connectorInstallationsCreated                ConnectorInstallation[]                @relation("ConnectorInstallationCreator")
  connectorAuditEvents                         ConnectorAuditEvent[]
  knowledgeDocumentsUploaded                   KnowledgeDocument[]                    @relation("KnowledgeDocumentUploader")
  channelConnectionsCreated                    ChannelConnection[]                    @relation("ChannelConnectionCreator")
  travelEmployeeConfigurationsCreated          TravelEmployeeConfiguration[]          @relation("TravelEmployeeConfigurationCreator")
  hrEmployeeConfigurationsCreated              HrEmployeeConfiguration[]              @relation("HrEmployeeConfigurationCreator")
  financeEmployeeConfigurationsCreated         FinanceEmployeeConfiguration[]         @relation("FinanceEmployeeConfigurationCreator")
  itSupportEmployeeConfigurationsCreated       ItSupportEmployeeConfiguration[]       @relation("ItSupportEmployeeConfigurationCreator")
  salesEmployeeConfigurationsCreated           SalesEmployeeConfiguration[]           @relation("SalesEmployeeConfigurationCreator")
  marketingEmployeeConfigurationsCreated       MarketingEmployeeConfiguration[]       @relation("MarketingEmployeeConfigurationCreator")
  legalEmployeeConfigurationsCreated           LegalEmployeeConfiguration[]           @relation("LegalEmployeeConfigurationCreator")
  customerSupportEmployeeConfigurationsCreated CustomerSupportEmployeeConfiguration[] @relation("CustomerSupportEmployeeConfigurationCreator")
  conversationAttachmentsCreated               ConversationAttachment[]               @relation("ConversationAttachmentCreator")
  legalDocumentsCreated                        LegalDocument[]                        @relation("LegalDocumentCreator")
  memoryRecords                                MemoryRecord[]
  passwordResetTokens                          PasswordResetToken[]
  deletedAt                                    DateTime?                              @map("deleted_at")

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("users")
}

/// Owns a slice of an AI Employee's knowledge base. Every KnowledgeDocument belongs to exactly one
/// collection, and every collection belongs to exactly one AI Employee (Plugin installation) within
/// one organization — this is the scoping boundary retrieval must never cross (see KnowledgeChunk).
model KnowledgeCollection {
  id                   String              @id @default(uuid()) @db.Uuid
  organizationId       String              @map("organization_id") @db.Uuid
  pluginInstallationId String              @map("plugin_installation_id") @db.Uuid
  name                 String              @db.VarChar(160)
  description          String?             @db.VarChar(1000)
  domain               String?             @db.VarChar(80)
  isDefault            Boolean             @default(false) @map("is_default")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  deletedAt            DateTime?           @map("deleted_at")
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pluginInstallation   Plugin              @relation(fields: [pluginInstallationId], references: [id], onDelete: Cascade)
  documents            KnowledgeDocument[]

  @@unique([pluginInstallationId, name])
  @@index([organizationId, pluginInstallationId, deletedAt])
  @@map("knowledge_collections")
}

model KnowledgeDocument {
  id               String                  @id @default(uuid()) @db.Uuid
  organizationId   String                  @map("organization_id") @db.Uuid
  collectionId     String                  @map("collection_id") @db.Uuid
  title            String                  @db.VarChar(200)
  originalFilename String                  @map("original_filename") @db.VarChar(255)
  mimeType         String                  @map("mime_type") @db.VarChar(160)
  fileSizeBytes    Int                     @map("file_size_bytes")
  storageKey       String?                 @map("storage_key") @db.VarChar(500)
  extractedText    String?                 @map("extracted_text") @db.Text
  status           KnowledgeDocumentStatus @default(UPLOADED)
  processingError  String?                 @map("processing_error") @db.VarChar(500)
  chunkCount       Int                     @default(0) @map("chunk_count")
  uploadedByUserId String                  @map("uploaded_by_user_id") @db.Uuid
  indexedAt        DateTime?               @map("indexed_at")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  deletedAt        DateTime?               @map("deleted_at")
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  collection       KnowledgeCollection     @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  uploadedBy       User                    @relation("KnowledgeDocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  chunks           KnowledgeChunk[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, deletedAt])
  @@index([collectionId, status, deletedAt])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id                   String                       @id @default(uuid()) @db.Uuid
  organizationId       String                       @map("organization_id") @db.Uuid
  /// Denormalized from the parent document's collection so retrieval can filter by employee with a
  /// single indexed predicate instead of joining through KnowledgeDocument -> KnowledgeCollection on
  /// every search. This is the field that makes cross-employee retrieval structurally impossible.
  pluginInstallationId String                       @map("plugin_installation_id") @db.Uuid
  collectionId         String                       @map("collection_id") @db.Uuid
  documentId           String                       @map("document_id") @db.Uuid
  chunkIndex           Int                          @map("chunk_index")
  content              String                       @db.Text
  tokenCount           Int                          @map("token_count")
  pageNumber           Int?                         @map("page_number")
  heading              String?                      @map("heading") @db.VarChar(255)
  sectionTitle         String?                      @map("section_title") @db.VarChar(255)
  isTable              Boolean                      @default(false) @map("is_table")
  metadata             Json                         @default("{}")
  /// Fixed-width embedding (see docs/enterprise-knowledge.md "Embedding dimensionality") queried via
  /// raw SQL — Prisma has no native vector type, so this column is written/read with $executeRaw /
  /// $queryRaw using the pgvector `<=>` cosine-distance operator instead of the generated client.
  embedding            Unsupported("vector(1536)")?
  embeddingModel       String?                      @map("embedding_model") @db.VarChar(160)
  embeddingDimensions  Int?                         @map("embedding_dimensions")
  createdAt            DateTime                     @default(now()) @map("created_at")
  updatedAt            DateTime                     @updatedAt @map("updated_at")
  organization         Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document             KnowledgeDocument            @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([organizationId, documentId])
  @@index([organizationId, createdAt])
  @@index([pluginInstallationId, collectionId])
  @@map("knowledge_chunks")
}

