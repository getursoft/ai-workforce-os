  businessHoursTimezone  String?   @map("business_hours_timezone") @db.VarChar(64)
  businessHoursStart     String?   @map("business_hours_start") @db.VarChar(5)
  businessHoursEnd       String?   @map("business_hours_end") @db.VarChar(5)
  escalationContact      String    @default("") @map("escalation_contact") @db.VarChar(255)
  brandTone              String    @default("FRIENDLY") @map("brand_tone") @db.VarChar(40)
  defaultCurrency        String    @default("USD") @map("default_currency") @db.VarChar(3)
