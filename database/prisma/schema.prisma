  @@map("subscription_plans")
}

model OrganisationSubscription {
  id                             String           @id @default(uuid()) @db.Uuid
  organizationId                 String           @unique @map("organization_id") @db.Uuid
  planId                         String           @map("plan_id") @db.Uuid
  status                         String           @default("ACTIVE") @db.VarChar(24)
  billingCycleStart              DateTime         @map("billing_cycle_start")
  billingCycleEnd                DateTime         @map("billing_cycle_end")
  monthlyCreditAllowanceOverride Int?             @map("monthly_credit_allowance_override")
  overageEnabledOverride         Boolean?         @map("overage_enabled_override")
  hardLimitEnabled               Boolean?         @default(false) @map("hard_limit_enabled")
  spendingCapCredits             Int?             @map("spending_cap_credits")
  createdAt                      DateTime         @default(now()) @map("created_at")
  updatedAt                      DateTime         @updatedAt @map("updated_at")
  organization                   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                           SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@map("organisation_subscriptions")
}

/**
 * A traveler-visible "top up credits" purchase — created PENDING the moment a package is selected,
 * moved to PAID only after the payment gateway's signature/webhook confirms a real captured payment (see
 * RazorpayService.verifySignature), never optimistically on the client's say-so.
 */
model CreditPurchaseOrder {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  createdBy        String       @map("created_by") @db.Uuid
  credits          Int
  amountMinor      Int          @map("amount_minor")
  currency         String       @db.VarChar(3)
  status           String       @default("PENDING") @db.VarChar(20)
  gateway          String       @default("RAZORPAY") @db.VarChar(20)
  gatewayOrderId   String?      @unique @map("gateway_order_id") @db.VarChar(120)
  gatewayPaymentId String?      @map("gateway_payment_id") @db.VarChar(120)
  failureReason    String?      @map("failure_reason") @db.VarChar(300)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  paidAt           DateTime?    @map("paid_at")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator          User         @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@map("credit_purchase_orders")
}

/// Per-organization payment gateway credentials (currently Razorpay only). Owner-only: gated by the
/// `billing.payment_settings.manage` permission, which is granted to the Owner system role alone (see
/// seed.ts DEFAULT_PERMISSIONS) so Admins/Members can spend credits but never see or rotate the keys.
/// Mirrors EmailDeliveryConfiguration's storage shape — non-secret `configuration` (the publishable
/// key_id) plus AES-256-GCM `encryptedSecrets` (the key_secret), never returned decrypted to the client.
model PaymentGatewayConfiguration {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  gateway          String       @default("RAZORPAY") @db.VarChar(20)
  configuration    Json
  encryptedSecrets Json         @map("encrypted_secrets")
  updatedBy        String       @map("updated_by") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updater          User         @relation("PaymentGatewayConfigurationUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@unique([organizationId, gateway])
  @@map("payment_gateway_configurations")
}

model UsageEvent {
  id                   String       @id @default(uuid()) @db.Uuid
  organizationId       String       @map("organization_id") @db.Uuid
  pluginInstallationId String?      @map("plugin_installation_id") @db.Uuid
  agentExecutionId     String?      @map("agent_execution_id") @db.Uuid
  conversationId       String?      @map("conversation_id") @db.Uuid
  provider             String?      @db.VarChar(80)
  model                String?      @db.VarChar(120)
  usageType            String       @map("usage_type") @db.VarChar(60)
  capability           String?      @db.VarChar(60)
  inputTokens          Int          @default(0) @map("input_tokens")
  cachedInputTokens    Int          @default(0) @map("cached_input_tokens")
  outputTokens         Int          @default(0) @map("output_tokens")
  reasoningTokens      Int          @default(0) @map("reasoning_tokens")
  totalTokens          Int          @default(0) @map("total_tokens")
  providerCostMicros   Int?         @map("provider_cost_micros")
  creditsConsumed      Int          @default(0) @map("credits_consumed")
  billable             Boolean      @default(true)
  status               String       @default("FINAL") @db.VarChar(20)
  occurredAt           DateTime     @map("occurred_at")
  idempotencyKey       String       @unique @map("idempotency_key") @db.VarChar(300)
  metadataJson         Json?        @map("metadata_json")
  createdAt            DateTime     @default(now()) @map("created_at")
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pluginInstallation   Plugin?      @relation(fields: [pluginInstallationId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([organizationId, pluginInstallationId, occurredAt])
  @@index([organizationId, capability, occurredAt])
  @@index([organizationId, provider, model, occurredAt])
  @@index([agentExecutionId])
  @@map("usage_events")
}

