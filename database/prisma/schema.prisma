generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  DISABLED

  @@map("organization_status")
}

enum LegacyUserRole {
  OWNER
  ADMIN
  MEMBER

  @@map("legacy_user_role")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED

  @@map("user_status")
}

enum TeamStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("team_status")
}

enum TeamMemberRole {
  MANAGER
  LEAD
  MEMBER

  @@map("team_member_role")
}

enum ServiceAccountStatus {
  ACTIVE
  DISABLED
  ARCHIVED

  @@map("service_account_status")
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED

  @@map("api_key_status")
}

enum ApiKeyEnvironment {
  LIVE
  TEST
  DEVELOPMENT

  @@map("api_key_environment")
}

enum PluginStatus {
  ACTIVE
  DISABLED
  DEPRECATED
  FAILED

  @@map("plugin_status")
}

model Organization {
  id                   String                @id @default(uuid()) @db.Uuid
  name                 String                @db.VarChar(120)
  slug                 String                @unique @db.VarChar(100)
  status               OrganizationStatus    @default(ACTIVE)
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  users                User[]
  settings             OrganizationSetting?
  roles                Role[]
  invitations          Invitation[]
  teams                Team[]
  serviceAccounts      ServiceAccount[]
  plugins              Plugin[]
  pluginConfigurations PluginConfiguration[]

  @@map("organizations")
}

model OrganizationSetting {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @unique @map("organization_id") @db.Uuid
  timezone       String       @db.VarChar(64)
  currency       String       @db.Char(3)
  locale         String       @db.VarChar(35)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

model User {
  id                          String                  @id @default(uuid()) @db.Uuid
  organizationId              String                  @map("organization_id") @db.Uuid
  firstName                   String                  @map("first_name") @db.VarChar(80)
  lastName                    String?                 @map("last_name") @db.VarChar(80)
  email                       String                  @db.VarChar(320)
  normalizedEmail             String                  @unique @map("normalized_email") @db.VarChar(320)
  passwordHash                String                  @map("password_hash") @db.VarChar(255)
  role                        LegacyUserRole
  status                      UserStatus
  lastLoginAt                 DateTime?               @map("last_login_at")
  createdAt                   DateTime                @default(now()) @map("created_at")
  updatedAt                   DateTime                @updatedAt @map("updated_at")
  organization                Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sessions                    AuthenticationSession[]
  userRoles                   UserRole[]
  invitationsSent             Invitation[]            @relation("InvitationSender")
  managedTeams                Team[]                  @relation("TeamManager")
  teamMemberships             TeamMember[]
  serviceAccountsCreated      ServiceAccount[]        @relation("ServiceAccountCreator")
  apiKeysCreated              ApiKey[]                @relation("ApiKeyCreator")
  apiKeysRevoked              ApiKey[]                @relation("ApiKeyRevoker")
  pluginConfigurationsUpdated PluginConfiguration[]   @relation("PluginConfigurationUpdater")
  deletedAt                   DateTime?               @map("deleted_at")

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("users")
}

model Plugin {
  id                  String               @id @default(uuid()) @db.Uuid
  organizationId      String               @map("organization_id") @db.Uuid
  name                String               @db.VarChar(120)
  slug                String               @db.VarChar(100)
  version             String               @db.VarChar(50)
  displayName         String               @map("display_name") @db.VarChar(160)
  description         String               @db.VarChar(1000)
  author              String               @db.VarChar(160)
  status              PluginStatus         @default(DISABLED)
  entryPoint          String               @map("entry_point") @db.VarChar(120)
  manifest            Json
  configSchema        Json?                @map("config_schema")
  grantedPermissions  Json                 @default("[]") @map("granted_permissions")
  installedAt         DateTime             @default(now()) @map("installed_at")
  enabledAt           DateTime?            @map("enabled_at")
  disabledAt          DateTime?            @map("disabled_at")
  lastStartedAt       DateTime?            @map("last_started_at")
  lastStoppedAt       DateTime?            @map("last_stopped_at")
  lastHealthStatus    String?              @map("last_health_status") @db.VarChar(32)
  lastHealthCheckedAt DateTime?            @map("last_health_checked_at")
  lastErrorCode       String?              @map("last_error_code") @db.VarChar(100)
  lastErrorMessage    String?              @map("last_error_message") @db.VarChar(500)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  deletedAt           DateTime?            @map("deleted_at")
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  configuration       PluginConfiguration?

  @@index([organizationId, slug])
  @@index([organizationId])
  @@index([organizationId, status, deletedAt])
  @@index([organizationId, deletedAt])
  @@map("plugins")
}

model PluginConfiguration {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  pluginId         String       @unique @map("plugin_id") @db.Uuid
  config           Json
  encryptedSecrets Json         @map("encrypted_secrets")
  updatedBy        String       @map("updated_by") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plugin           Plugin       @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  updater          User         @relation("PluginConfigurationUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([organizationId, pluginId])
  @@map("plugin_configurations")
}

model Team {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(120)
  slug           String       @db.VarChar(140)
  description    String?      @db.VarChar(500)
  managerId      String?      @map("manager_id") @db.Uuid
  parentTeamId   String?      @map("parent_team_id") @db.Uuid
  status         TeamStatus   @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  manager        User?        @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  parentTeam     Team?        @relation("TeamHierarchy", fields: [parentTeamId], references: [id], onDelete: SetNull)
  childTeams     Team[]       @relation("TeamHierarchy")
  members        TeamMember[]

  @@unique([organizationId, slug])
  @@index([organizationId, status, deletedAt])
  @@index([managerId])
  @@index([parentTeamId])
  @@map("teams")
}

model TeamMember {
  teamId    String         @map("team_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  role      TeamMemberRole @default(MEMBER)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  team      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model Role {
  id                  String               @id @default(uuid()) @db.Uuid
  organizationId      String               @map("organization_id") @db.Uuid
  name                String               @db.VarChar(80)
  description         String?              @db.VarChar(255)
  isSystem            Boolean              @default(false) @map("is_system")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions         RolePermission[]
  users               UserRole[]
  serviceAccountRoles ServiceAccountRole[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(100)
  description String?          @db.VarChar(255)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model ServiceAccount {
  id              String               @id @default(uuid()) @db.Uuid
  organizationId  String               @map("organization_id") @db.Uuid
  name            String               @db.VarChar(120)
  description     String?              @db.VarChar(500)
  status          ServiceAccountStatus @default(ACTIVE)
  createdByUserId String               @map("created_by_user_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  deletedAt       DateTime?            @map("deleted_at")
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User                 @relation("ServiceAccountCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  apiKeys         ApiKey[]
  roles           ServiceAccountRole[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("service_accounts")
}

model ApiKey {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  serviceAccountId String            @map("service_account_id") @db.Uuid
  name             String            @db.VarChar(120)
  keyPrefix        String            @map("key_prefix") @db.VarChar(16)
  publicId         String            @unique @map("public_id") @db.VarChar(32)
  maskedValue      String            @map("masked_value") @db.VarChar(80)
  secretHash       String            @map("secret_hash") @db.Char(64)
  hashVersion      Int               @default(1) @map("hash_version")
  environment      ApiKeyEnvironment
  status           ApiKeyStatus      @default(ACTIVE)
  expiresAt        DateTime?         @map("expires_at")
  lastUsedAt       DateTime?         @map("last_used_at")
  revokedAt        DateTime?         @map("revoked_at")
  createdByUserId  String            @map("created_by_user_id") @db.Uuid
  revokedByUserId  String?           @map("revoked_by_user_id") @db.Uuid
  replacementKeyId String?           @unique @map("replacement_key_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  serviceAccount   ServiceAccount    @relation(fields: [serviceAccountId], references: [id], onDelete: Cascade)
  createdBy        User              @relation("ApiKeyCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  revokedBy        User?             @relation("ApiKeyRevoker", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  replacementKey   ApiKey?           @relation("ApiKeyRotation", fields: [replacementKeyId], references: [id], onDelete: SetNull)
  replaces         ApiKey?           @relation("ApiKeyRotation")

  @@index([publicId])
  @@index([organizationId, status])
  @@index([serviceAccountId])
  @@map("api_keys")
}

model ServiceAccountRole {
  serviceAccountId String         @map("service_account_id") @db.Uuid
  roleId           String         @map("role_id") @db.Uuid
  assignedAt       DateTime       @default(now()) @map("assigned_at")
  serviceAccount   ServiceAccount @relation(fields: [serviceAccountId], references: [id], onDelete: Cascade)
  role             Role           @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([serviceAccountId, roleId])
  @@index([roleId])
  @@map("service_account_roles")
}

model Invitation {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  email           String       @db.VarChar(320)
  normalizedEmail String       @map("normalized_email") @db.VarChar(320)
  tokenHash       String       @unique @map("token_hash") @db.Char(64)
  roleIds         Json         @map("role_ids")
  invitedById     String       @map("invited_by_id") @db.Uuid
  expiresAt       DateTime     @map("expires_at")
  acceptedAt      DateTime?    @map("accepted_at")
  revokedAt       DateTime?    @map("revoked_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy       User         @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([organizationId, normalizedEmail])
  @@index([expiresAt])
  @@map("invitations")
}

model AuthenticationSession {
  id                  String                 @id @default(uuid()) @db.Uuid
  userId              String                 @map("user_id") @db.Uuid
  tokenHash           String                 @map("token_hash") @db.VarChar(128)
  familyId            String                 @map("family_id") @db.Uuid
  expiresAt           DateTime               @map("expires_at")
  revokedAt           DateTime?              @map("revoked_at")
  replacedBySessionId String?                @unique @map("replaced_by_session_id") @db.Uuid
  lastUsedAt          DateTime?              @map("last_used_at")
  ipAddress           String?                @map("ip_address") @db.VarChar(64)
  userAgent           String?                @map("user_agent") @db.VarChar(512)
  createdAt           DateTime               @default(now()) @map("created_at")
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy          AuthenticationSession? @relation("SessionReplacement", fields: [replacedBySessionId], references: [id], onDelete: SetNull)
  replaces            AuthenticationSession? @relation("SessionReplacement")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@index([userId, revokedAt])
  @@map("authentication_sessions")
}
