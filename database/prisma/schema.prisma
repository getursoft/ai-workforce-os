generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  DISABLED

  @@map("organization_status")
}

enum LegacyUserRole {
  OWNER
  ADMIN
  MEMBER

  @@map("legacy_user_role")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED

  @@map("user_status")
}

enum TeamStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("team_status")
}

enum TeamMemberRole {
  MANAGER
  LEAD
  MEMBER

  @@map("team_member_role")
}

enum ServiceAccountStatus {
  ACTIVE
  DISABLED
  ARCHIVED

  @@map("service_account_status")
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED

  @@map("api_key_status")
}

enum ApiKeyEnvironment {
  LIVE
  TEST
  DEVELOPMENT

  @@map("api_key_environment")
}

enum PluginStatus {
  ACTIVE
  DISABLED
  DEPRECATED
  FAILED

  @@map("plugin_status")
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED

  @@map("conversation_status")
}

enum ConversationMessageRole {
  SYSTEM
  USER
  ASSISTANT
  TOOL

  @@map("conversation_message_role")
}

enum AgentExecutionStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  TIMED_OUT

  @@map("agent_execution_status")
}

enum AgentToolExecutionStatus {
  REQUESTED
  RUNNING
  COMPLETED
  FAILED
  DENIED
  TIMED_OUT

  @@map("agent_tool_execution_status")
}

enum SkillExecutionStatus {
  ACTIVE
  WAITING_FOR_INPUT
  READY
  COMPLETED
  CANCELLED
  FAILED

  @@map("skill_execution_status")
}

/// Stage 9B: reusable, typed pending-workflow persistence — the smallest general mechanism for a
/// multi-turn business workflow that must resume before intent classification / RAG / capability
/// routing. CONTACT_CAPTURE is the first (and, for this stage, only) workflow using it.
enum WorkflowType {
  CONTACT_CAPTURE
  BOOKING_HANDOFF
  TRIP_SUBMISSION

  @@map("workflow_type")
}

enum WorkflowStatus {
  ACTIVE
  WAITING_FOR_INPUT
  WAITING_FOR_APPROVAL
  COMPLETED
  FAILED
  CANCELLED

  @@map("workflow_status")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED

  @@map("approval_status")
}

enum AgentMemoryScope {
  USER
  CONVERSATION
  PLUGIN
  ORGANIZATION

  @@map("agent_memory_scope")
}

/// How a customer was identified for a conversation. ANONYMOUS identities are never persisted as a
/// CustomerProfile row — only PHONE/CRM_ID/PORTAL_USER (durable, cross-conversation identities) are.
enum CustomerIdentityType {
  PHONE
  CRM_ID
  PORTAL_USER
  ANONYMOUS

  @@map("customer_identity_type")
}

enum PluginAiProviderType {
  DETERMINISTIC
  OPENAI_COMPATIBLE
  AZURE_OPENAI

  @@map("plugin_ai_provider_type")
}

enum ConnectorAuthType {
  NONE
  API_KEY
  BEARER_TOKEN
  BASIC_AUTH
  OAUTH2
  CUSTOM

  @@map("connector_auth_type")
}

enum ConnectorDefinitionStatus {
  ACTIVE
  DEPRECATED
  DISABLED

  @@map("connector_definition_status")
}

enum ConnectorInstallationStatus {
  DRAFT
  CONNECTED
  READY
  DISABLED
  AUTH_FAILED
  EXPIRED
  DEGRADED
  FAILED
  DISCONNECTED
  ARCHIVED

  @@map("connector_installation_status")
}

enum ConnectorHealthStatus {
  UNKNOWN
  READY
  DEGRADED
  FAILED
  AUTH_FAILED
  EXPIRED
  RATE_LIMITED
  DISCONNECTED

  @@map("connector_health_status")
}

enum ConnectorRiskLevel {
  LOW
  MEDIUM
  HIGH

  @@map("connector_risk_level")
}

enum ConnectorOperationType {
  READ
  WRITE

  @@map("connector_operation_type")
}

enum ConnectorExecutionStatus {
  RUNNING
  SUCCEEDED
  FAILED
  DENIED
  TIMED_OUT

  @@map("connector_execution_status")
}

enum ConnectorActorType {
  USER
  SERVICE_ACCOUNT
  AGENT
  SYSTEM

  @@map("connector_actor_type")
}

enum ConnectorEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
  DUPLICATE

  @@map("connector_event_status")
}

enum KnowledgeDocumentStatus {
  UPLOADED
  PROCESSING
  INDEXED
  FAILED

  @@map("knowledge_document_status")
}

enum ChannelProvider {
  TWILIO
  META_CLOUD_API

  @@map("channel_provider")
}

enum ChannelType {
  WHATSAPP

  @@map("channel_type")
}

enum ChannelConnectionStatus {
  DRAFT
  CONNECTING
  CONNECTED
  ACTIVE
  DEGRADED
  FAILED
  DISABLED

  @@map("channel_connection_status")
}

enum ChannelMessageDirection {
  INBOUND
  OUTBOUND

  @@map("channel_message_direction")
}

enum ChannelMessageStatus {
  RECEIVED
  PROCESSING
  SENT
  FAILED

  @@map("channel_message_status")
}

/// A lead's progress through human follow-up, set by staff — the Conversation Completion framework itself
/// only ever creates a lead as NEW; it never advances status on its own.
enum TravelLeadStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED

  @@map("travel_lead_status")
}

/// Whether the best-effort external CRM mirror (see `TravelLeadService.createInternalLead` /
/// `AgentService.syncLeadToCrmBestEffort`) has run for this lead — purely observational. The internal
/// `TravelLead` row is always created first and is never rolled back or blocked by this outcome.
enum TravelLeadCrmSyncStatus {
  /// No CRM connector was configured, or the sync attempt hasn't run yet.
  PENDING
  /// Mirrored to the external CRM successfully.
  SYNCED
  /// The CRM connector threw, timed out, or rejected the payload — logged, never customer-facing.
  FAILED
  /// No CRM tool is available for this organization — mirroring was never attempted.
  SKIPPED

  @@map("travel_lead_crm_sync_status")
}

model Organization {
  id                           String                        @id @default(uuid()) @db.Uuid
  name                         String                        @db.VarChar(120)
  slug                         String                        @unique @db.VarChar(100)
  status                       OrganizationStatus            @default(ACTIVE)
  createdAt                    DateTime                      @default(now()) @map("created_at")
  updatedAt                    DateTime                      @updatedAt @map("updated_at")
  users                        User[]
  settings                     OrganizationSetting?
  roles                        Role[]
  invitations                  Invitation[]
  teams                        Team[]
  serviceAccounts              ServiceAccount[]
  plugins                      Plugin[]
  pluginConfigurations         PluginConfiguration[]
  conversations                Conversation[]
  agentExecutions              AgentExecution[]
  agentToolExecutions          AgentToolExecution[]
  agentMemories                AgentMemory[]
  pluginAiConfigurations       PluginAiConfiguration[]
  connectorInstallations       ConnectorInstallation[]
  connectorExecutions          ConnectorExecution[]
  connectorEvents              ConnectorEvent[]
  connectorAuditEvents         ConnectorAuditEvent[]
  dummyCrmLeads                DummyCrmLead[]
  knowledgeCollections         KnowledgeCollection[]
  knowledgeDocuments           KnowledgeDocument[]
  knowledgeChunks              KnowledgeChunk[]
  channelConnections           ChannelConnection[]
  channelMessages              ChannelMessage[]
  travelEmployeeConfigurations TravelEmployeeConfiguration[]
  customerProfiles             CustomerProfile[]
  travelLeads                  TravelLead[]
  skillExecutions              SkillExecution[]
  workflowExecutions           WorkflowExecution[]
  approvalRequests             ApprovalRequest[]
  employeeRoutingProfiles      EmployeeRoutingProfile[]
  usageEvents                  UsageEvent[]
  subscription                 OrganisationSubscription?

  @@map("organizations")
}

model SubscriptionPlan {
  id                     String   @id @default(uuid()) @db.Uuid
  code                   String   @unique @db.VarChar(40)
  name                   String   @db.VarChar(120)
  description            String   @db.VarChar(500)
  monthlyCreditAllowance Int      @map("monthly_credit_allowance")
  overageEnabled         Boolean  @default(false) @map("overage_enabled")
  overageRateMicrosPerCredit Int  @default(0) @map("overage_rate_micros_per_credit")
  activeEmployeeLimit    Int?     @map("active_employee_limit")
  isActive               Boolean  @default(true) @map("is_active")
  metadataJson           Json     @default("{}") @map("metadata_json")
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")
  subscriptions          OrganisationSubscription[]

  @@map("subscription_plans")
}

model OrganisationSubscription {
  id                          String             @id @default(uuid()) @db.Uuid
  organizationId              String             @unique @map("organization_id") @db.Uuid
  planId                      String             @map("plan_id") @db.Uuid
  status                      String             @default("ACTIVE") @db.VarChar(24)
  billingCycleStart           DateTime           @map("billing_cycle_start")
  billingCycleEnd             DateTime           @map("billing_cycle_end")
  monthlyCreditAllowanceOverride Int?             @map("monthly_credit_allowance_override")
  overageEnabledOverride      Boolean?            @map("overage_enabled_override")
  hardLimitEnabled            Boolean?            @default(false) @map("hard_limit_enabled")
  spendingCapCredits          Int?                @map("spending_cap_credits")
  createdAt                   DateTime            @default(now()) @map("created_at")
  updatedAt                   DateTime            @updatedAt @map("updated_at")
  organization                Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                        SubscriptionPlan    @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@map("organisation_subscriptions")
}

model UsageEvent {
  id                   String   @id @default(uuid()) @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  pluginInstallationId String?  @map("plugin_installation_id") @db.Uuid
  agentExecutionId     String?  @map("agent_execution_id") @db.Uuid
  conversationId       String?  @map("conversation_id") @db.Uuid
  provider             String?  @db.VarChar(80)
  model                String?  @db.VarChar(120)
  usageType            String   @map("usage_type") @db.VarChar(60)
  capability           String?  @db.VarChar(60)
  inputTokens          Int      @default(0) @map("input_tokens")
  cachedInputTokens    Int      @default(0) @map("cached_input_tokens")
  outputTokens         Int      @default(0) @map("output_tokens")
  reasoningTokens      Int      @default(0) @map("reasoning_tokens")
  totalTokens          Int      @default(0) @map("total_tokens")
  providerCostMicros   Int?     @map("provider_cost_micros")
  creditsConsumed      Int      @default(0) @map("credits_consumed")
  billable             Boolean  @default(true)
  status               String   @default("FINAL") @db.VarChar(20)
  occurredAt           DateTime @map("occurred_at")
  idempotencyKey       String   @unique @map("idempotency_key") @db.VarChar(300)
  metadataJson         Json?    @map("metadata_json")
  createdAt            DateTime @default(now()) @map("created_at")
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pluginInstallation   Plugin?     @relation(fields: [pluginInstallationId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([organizationId, pluginInstallationId, occurredAt])
  @@index([organizationId, capability, occurredAt])
  @@index([organizationId, provider, model, occurredAt])
  @@index([agentExecutionId])
  @@map("usage_events")
}

model OrganizationSetting {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @unique @map("organization_id") @db.Uuid
  timezone       String       @db.VarChar(64)
  currency       String       @db.Char(3)
  locale         String       @db.VarChar(35)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

model User {
  id                                  String                        @id @default(uuid()) @db.Uuid
  organizationId                      String                        @map("organization_id") @db.Uuid
  firstName                           String                        @map("first_name") @db.VarChar(80)
  lastName                            String?                       @map("last_name") @db.VarChar(80)
  email                               String                        @db.VarChar(320)
  normalizedEmail                     String                        @unique @map("normalized_email") @db.VarChar(320)
  passwordHash                        String                        @map("password_hash") @db.VarChar(255)
  role                                LegacyUserRole
  status                              UserStatus
  lastLoginAt                         DateTime?                     @map("last_login_at")
  createdAt                           DateTime                      @default(now()) @map("created_at")
  updatedAt                           DateTime                      @updatedAt @map("updated_at")
  organization                        Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sessions                            AuthenticationSession[]
  userRoles                           UserRole[]
  invitationsSent                     Invitation[]                  @relation("InvitationSender")
  managedTeams                        Team[]                        @relation("TeamManager")
  teamMemberships                     TeamMember[]
  serviceAccountsCreated              ServiceAccount[]              @relation("ServiceAccountCreator")
  apiKeysCreated                      ApiKey[]                      @relation("ApiKeyCreator")
  apiKeysRevoked                      ApiKey[]                      @relation("ApiKeyRevoker")
  pluginConfigurationsUpdated         PluginConfiguration[]         @relation("PluginConfigurationUpdater")
  conversationsCreated                Conversation[]
  agentExecutions                     AgentExecution[]
  agentMemories                       AgentMemory[]
  pluginAiConfigurationsUpdated       PluginAiConfiguration[]       @relation("PluginAiConfigurationUpdater")
  connectorInstallationsCreated       ConnectorInstallation[]       @relation("ConnectorInstallationCreator")
  connectorAuditEvents                ConnectorAuditEvent[]
  knowledgeDocumentsUploaded          KnowledgeDocument[]           @relation("KnowledgeDocumentUploader")
  channelConnectionsCreated           ChannelConnection[]           @relation("ChannelConnectionCreator")
  travelEmployeeConfigurationsCreated TravelEmployeeConfiguration[] @relation("TravelEmployeeConfigurationCreator")
  deletedAt                           DateTime?                     @map("deleted_at")

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("users")
}

/// Owns a slice of an AI Employee's knowledge base. Every KnowledgeDocument belongs to exactly one
/// collection, and every collection belongs to exactly one AI Employee (Plugin installation) within
/// one organization — this is the scoping boundary retrieval must never cross (see KnowledgeChunk).
model KnowledgeCollection {
  id                   String              @id @default(uuid()) @db.Uuid
  organizationId       String              @map("organization_id") @db.Uuid
  pluginInstallationId String              @map("plugin_installation_id") @db.Uuid
  name                 String              @db.VarChar(160)
  description          String?             @db.VarChar(1000)
  domain               String?             @db.VarChar(80)
  isDefault            Boolean             @default(false) @map("is_default")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  deletedAt            DateTime?           @map("deleted_at")
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pluginInstallation   Plugin              @relation(fields: [pluginInstallationId], references: [id], onDelete: Cascade)
  documents            KnowledgeDocument[]

  @@unique([pluginInstallationId, name])
  @@index([organizationId, pluginInstallationId, deletedAt])
  @@map("knowledge_collections")
}

model KnowledgeDocument {
  id               String                  @id @default(uuid()) @db.Uuid
  organizationId   String                  @map("organization_id") @db.Uuid
  collectionId     String                  @map("collection_id") @db.Uuid
  title            String                  @db.VarChar(200)
  originalFilename String                  @map("original_filename") @db.VarChar(255)
  mimeType         String                  @map("mime_type") @db.VarChar(160)
  fileSizeBytes    Int                     @map("file_size_bytes")
  storageKey       String?                 @map("storage_key") @db.VarChar(500)
  extractedText    String?                 @map("extracted_text") @db.Text
  status           KnowledgeDocumentStatus @default(UPLOADED)
  processingError  String?                 @map("processing_error") @db.VarChar(500)
  chunkCount       Int                     @default(0) @map("chunk_count")
  uploadedByUserId String                  @map("uploaded_by_user_id") @db.Uuid
  indexedAt        DateTime?               @map("indexed_at")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  deletedAt        DateTime?               @map("deleted_at")
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  collection       KnowledgeCollection     @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  uploadedBy       User                    @relation("KnowledgeDocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  chunks           KnowledgeChunk[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, deletedAt])
  @@index([collectionId, status, deletedAt])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id                   String                       @id @default(uuid()) @db.Uuid
  organizationId       String                       @map("organization_id") @db.Uuid
  /// Denormalized from the parent document's collection so retrieval can filter by employee with a
  /// single indexed predicate instead of joining through KnowledgeDocument -> KnowledgeCollection on
  /// every search. This is the field that makes cross-employee retrieval structurally impossible.
  pluginInstallationId String                       @map("plugin_installation_id") @db.Uuid
  collectionId         String                       @map("collection_id") @db.Uuid
  documentId           String                       @map("document_id") @db.Uuid
  chunkIndex           Int                          @map("chunk_index")
  content              String                       @db.Text
  tokenCount           Int                          @map("token_count")
  pageNumber           Int?                         @map("page_number")
  heading              String?                      @map("heading") @db.VarChar(255)
  sectionTitle         String?                      @map("section_title") @db.VarChar(255)
  isTable              Boolean                      @default(false) @map("is_table")
  metadata             Json                         @default("{}")
  /// Fixed-width embedding (see docs/enterprise-knowledge.md "Embedding dimensionality") queried via
  /// raw SQL — Prisma has no native vector type, so this column is written/read with $executeRaw /
  /// $queryRaw using the pgvector `<=>` cosine-distance operator instead of the generated client.
  embedding            Unsupported("vector(1536)")?
  embeddingModel       String?                      @map("embedding_model") @db.VarChar(160)
  embeddingDimensions  Int?                         @map("embedding_dimensions")
  createdAt            DateTime                     @default(now()) @map("created_at")
  updatedAt            DateTime                     @updatedAt @map("updated_at")
  organization         Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document             KnowledgeDocument            @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([organizationId, documentId])
  @@index([organizationId, createdAt])
  @@index([pluginInstallationId, collectionId])
  @@map("knowledge_chunks")
}

model Plugin {
  id                          String                       @id @default(uuid()) @db.Uuid
  organizationId              String                       @map("organization_id") @db.Uuid
  name                        String                       @db.VarChar(120)
  slug                        String                       @db.VarChar(100)
  version                     String                       @db.VarChar(50)
  displayName                 String                       @map("display_name") @db.VarChar(160)
  description                 String                       @db.VarChar(1000)
  author                      String                       @db.VarChar(160)
  status                      PluginStatus                 @default(DISABLED)
  entryPoint                  String                       @map("entry_point") @db.VarChar(120)
  manifest                    Json
  configSchema                Json?                        @map("config_schema")
  grantedPermissions          Json                         @default("[]") @map("granted_permissions")
  installedAt                 DateTime                     @default(now()) @map("installed_at")
  enabledAt                   DateTime?                    @map("enabled_at")
  disabledAt                  DateTime?                    @map("disabled_at")
  lastStartedAt               DateTime?                    @map("last_started_at")
  lastStoppedAt               DateTime?                    @map("last_stopped_at")
  lastHealthStatus            String?                      @map("last_health_status") @db.VarChar(32)
  lastHealthCheckedAt         DateTime?                    @map("last_health_checked_at")
  lastErrorCode               String?                      @map("last_error_code") @db.VarChar(100)
  lastErrorMessage            String?                      @map("last_error_message") @db.VarChar(500)
  createdAt                   DateTime                     @default(now()) @map("created_at")
  updatedAt                   DateTime                     @updatedAt @map("updated_at")
  deletedAt                   DateTime?                    @map("deleted_at")
  organization                Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  configuration               PluginConfiguration?
  conversations               Conversation[]
  agentExecutions             AgentExecution[]
  agentMemories               AgentMemory[]
  aiConfiguration             PluginAiConfiguration?
  channelConnections          ChannelConnection[]
  knowledgeCollections        KnowledgeCollection[]
  travelEmployeeConfiguration TravelEmployeeConfiguration?
  travelLeads                 TravelLead[]
  skillExecutions             SkillExecution[]
  workflowExecutions          WorkflowExecution[]
  employeeRoutingProfile      EmployeeRoutingProfile?
  usageEvents                 UsageEvent[]

  @@index([organizationId, slug])
  @@index([organizationId])
  @@index([organizationId, status, deletedAt])
  @@index([organizationId, deletedAt])
  @@map("plugins")
}

model Conversation {
  id                   String                @id @default(uuid()) @db.Uuid
  organizationId       String                @map("organization_id") @db.Uuid
  pluginInstallationId String                @map("plugin_installation_id") @db.Uuid
  createdByUserId      String?               @map("created_by_user_id") @db.Uuid
  channelConnectionId  String?               @map("channel_connection_id") @db.Uuid
  externalUserId       String?               @map("external_user_id") @db.VarChar(64)
  /// The customer this conversation belongs to, resolved via the CustomerIdentityService. Null means
  /// the customer identity was anonymous/unknown for this conversation (e.g. a fresh dashboard test run
  /// or a first-contact visitor) — distinct from `createdByUserId`, which is the staff member who ran it.
  customerProfileId    String?               @map("customer_profile_id") @db.Uuid
  title                String                @db.VarChar(160)
  status               ConversationStatus    @default(ACTIVE)
  metadata             Json                  @default("{}")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  deletedAt            DateTime?             @map("deleted_at")
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pluginInstallation   Plugin                @relation(fields: [pluginInstallationId], references: [id], onDelete: Restrict)
  createdBy            User?                 @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  channelConnection    ChannelConnection?    @relation(fields: [channelConnectionId], references: [id], onDelete: Cascade)
  customerProfile      CustomerProfile?      @relation(fields: [customerProfileId], references: [id], onDelete: SetNull)
  messages             ConversationMessage[]
  executions           AgentExecution[]
  memories             AgentMemory[]
  channelMessages      ChannelMessage[]
  travelLeads          TravelLead[]
  skillExecutions      SkillExecution[]
  workflowExecutions   WorkflowExecution[]

  @@index([organizationId, status, updatedAt])
  @@index([organizationId, pluginInstallationId])
  @@index([organizationId, channelConnectionId, externalUserId, status])
  @@index([organizationId, customerProfileId])
  @@map("conversations")
}

/// A customer's durable identity and profile — independent of any single Conversation. One customer
/// (a WhatsApp phone number, a CRM record, or a future logged-in portal user) may have many
/// conversations over time, each starting with a clean ConversationMemory/TripState, but all of them
/// resolving back to this same profile so returning customers can be recognized ("Welcome back Krishna")
/// without conversations leaking context into one another. Reusable by any AI Employee, not just Travel.
model CustomerProfile {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  identityType   CustomerIdentityType @map("identity_type")
  /// The identity's natural key within its type: E.164 phone number for PHONE, CRM record id for
  /// CRM_ID, portal user id for PORTAL_USER. Never populated for ANONYMOUS (those aren't persisted).
  externalId     String               @map("external_id") @db.VarChar(160)
  displayName    String?              @map("display_name") @db.VarChar(160)
  preferences    Json                 @default("{}")
  currency       String?              @db.VarChar(8)
  language       String?              @db.VarChar(16)
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  deletedAt      DateTime?            @map("deleted_at")
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations  Conversation[]

  @@unique([organizationId, identityType, externalId])
  @@index([organizationId, identityType])
  @@map("customer_profiles")
}

model ConversationMessage {
  id              String                  @id @default(uuid()) @db.Uuid
  conversationId  String                  @map("conversation_id") @db.Uuid
  organizationId  String                  @map("organization_id") @db.Uuid
  toolExecutionId String?                 @map("tool_execution_id") @db.Uuid
  role            ConversationMessageRole
  content         String                  @db.Text
  contentJson     Json?                   @map("content_json")
  model           String?                 @db.VarChar(120)
  inputTokens     Int?                    @map("input_tokens")
  outputTokens    Int?                    @map("output_tokens")
  createdAt       DateTime                @default(now()) @map("created_at")
  conversation    Conversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  toolExecution   AgentToolExecution?     @relation(fields: [toolExecutionId], references: [id], onDelete: SetNull)

  @@index([organizationId, conversationId, createdAt])
  @@index([toolExecutionId])
  @@map("conversation_messages")
}

model AgentExecution {
