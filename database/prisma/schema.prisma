/// A lead generated for Krevia AS A BUSINESS (the platform's own acquisition funnel), never a tenant
/// organization's own customer lead — those stay in SalesLead/TravelLead/etc, each tied to an
/// organizationId. Deliberately has NO organizationId/pluginInstallationId/conversationId column at all:
/// a public website visitor submitting "Book a Demo" is not yet a customer of any tenant, so there is
/// structurally nothing tenant-scoped to attach — this is the strongest possible guarantee that the
/// Platform Owner's Sales Leads screen can never become a cross-tenant CRM surveillance dump (see
/// PlatformLeadsController, guarded by PlatformOwnerGuard). `scope` is still stored explicitly (always
/// PLATFORM today) so the read path's tenant-isolation guarantee is a visible query condition.
model PlatformLead {
  id                String             @id @default(uuid()) @db.Uuid
  scope             PlatformLeadScope  @default(PLATFORM)
  source            PlatformLeadSource
  type              PlatformLeadType
  name              String             @db.VarChar(160)
  email             String             @db.VarChar(320)
  phone             String?            @db.VarChar(40)
  company           String?            @db.VarChar(160)
  /// Free-text requirement/message. Never rendered directly in the leads table (only in lead detail) —
  /// see the dashboard Sales Leads page.
  requirement       String?            @db.Text
  /// Extra structured fields the source form collected that don't warrant their own column (e.g. job
  /// title, company size, department, use case) — shown only in lead detail, never in the table.
  metadata          Json               @default("{}")
  preferredDemoDate String?            @map("preferred_demo_date") @db.VarChar(60)
  preferredDemoTime String?            @map("preferred_demo_time") @db.VarChar(60)
  timezone          String?            @db.VarChar(60)
  status            PlatformLeadStatus @default(NEW)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@index([scope, status, createdAt])
  @@index([scope, source, createdAt])
  @@map("platform_leads")
}

