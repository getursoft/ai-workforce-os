model Conversation {
  id                     String                   @id @default(uuid()) @db.Uuid
  organizationId         String                   @map("organization_id") @db.Uuid
  pluginInstallationId   String                   @map("plugin_installation_id") @db.Uuid
  createdByUserId        String?                  @map("created_by_user_id") @db.Uuid
  channelConnectionId    String?                  @map("channel_connection_id") @db.Uuid
  externalUserId         String?                  @map("external_user_id") @db.VarChar(64)
  /// The customer this conversation belongs to, resolved via the CustomerIdentityService. Null means
  /// the customer identity was anonymous/unknown for this conversation (e.g. a fresh dashboard test run
  /// or a first-contact visitor) — distinct from `createdByUserId`, which is the staff member who ran it.
  customerProfileId      String?                  @map("customer_profile_id") @db.Uuid
  title                  String                   @db.VarChar(160)
  status                 ConversationStatus       @default(ACTIVE)
  metadata               Json                     @default("{}")
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")
  deletedAt              DateTime?                @map("deleted_at")
  organization           Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pluginInstallation     Plugin                   @relation(fields: [pluginInstallationId], references: [id], onDelete: Restrict)
  createdBy              User?                    @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  channelConnection      ChannelConnection?       @relation(fields: [channelConnectionId], references: [id], onDelete: Cascade)
  customerProfile        CustomerProfile?         @relation(fields: [customerProfileId], references: [id], onDelete: SetNull)
  messages               ConversationMessage[]
  executions             AgentExecution[]
  memories               AgentMemory[]
  channelMessages        ChannelMessage[]
  travelLeads            TravelLead[]
  skillExecutions        SkillExecution[]
  workflowExecutions     WorkflowExecution[]
  travelBookings         TravelBooking[]
  hrTickets              HrTicket[]
  financeRecords         FinanceRecord[]
  itSupportTickets       ItSupportTicket[]
  salesLeads             SalesLead[]
  marketingCampaigns     MarketingCampaign[]
  legalNotices           LegalNotice[]
  customerSupportTickets CustomerSupportTicket[]
  attachments            ConversationAttachment[]
  legalDocuments         LegalDocument[]
  memoryRecords          MemoryRecord[]
  conversationSummaries  ConversationSummary[]
  skillRuns              SkillRun[]

  @@index([organizationId, status, updatedAt])
  @@index([organizationId, pluginInstallationId])
  @@index([organizationId, channelConnectionId, externalUserId, status])
  @@index([organizationId, customerProfileId])
  @@map("conversations")
}

/// A customer's durable identity and profile — independent of any single Conversation. One customer
/// (a WhatsApp phone number, a CRM record, or a future logged-in portal user) may have many
/// conversations over time, each starting with a clean ConversationMemory/TripState, but all of them
/// resolving back to this same profile so returning customers can be recognized ("Welcome back Krishna")
/// without conversations leaking context into one another. Reusable by any AI Employee, not just Travel.
model CustomerProfile {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  identityType   CustomerIdentityType @map("identity_type")
  /// The identity's natural key within its type: E.164 phone number for PHONE, CRM record id for
  /// CRM_ID, portal user id for PORTAL_USER. Never populated for ANONYMOUS (those aren't persisted).
  externalId     String               @map("external_id") @db.VarChar(160)
  displayName    String?              @map("display_name") @db.VarChar(160)
  preferences    Json                 @default("{}")
  currency       String?              @db.VarChar(8)
  language       String?              @db.VarChar(16)
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  deletedAt      DateTime?            @map("deleted_at")
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations  Conversation[]

  @@unique([organizationId, identityType, externalId])
  @@index([organizationId, identityType])
  @@map("customer_profiles")
}

model ConversationMessage {
  id              String                  @id @default(uuid()) @db.Uuid
  conversationId  String                  @map("conversation_id") @db.Uuid
  organizationId  String                  @map("organization_id") @db.Uuid
  toolExecutionId String?                 @map("tool_execution_id") @db.Uuid
  role            ConversationMessageRole
  content         String                  @db.Text
  contentJson     Json?                   @map("content_json")
  model           String?                 @db.VarChar(120)
  inputTokens     Int?                    @map("input_tokens")
  outputTokens    Int?                    @map("output_tokens")
  createdAt       DateTime                @default(now()) @map("created_at")
  conversation    Conversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  toolExecution   AgentToolExecution?     @relation(fields: [toolExecutionId], references: [id], onDelete: SetNull)

  @@index([organizationId, conversationId, createdAt])
  @@index([toolExecutionId])
  @@map("conversation_messages")
}

/// A file the user attached to a conversation (text, PDF, Word, JPG/PNG image) so an AI Employee can read
/// its contents. The extracted text is stored on the row and injected into the agent's conversation context
/// on the next run, so the employee can answer from the attachment. WhatsApp channel attachments will use
/// the same model when the channel adapter lands.
model ConversationAttachment {
  id                   String       @id @default(uuid()) @db.Uuid
  organizationId       String       @map("organization_id") @db.Uuid
  pluginInstallationId String       @map("plugin_installation_id") @db.Uuid
  conversationId       String       @map("conversation_id") @db.Uuid
  createdByUserId      String?      @map("created_by_user_id") @db.Uuid
  originalFilename     String       @map("original_filename") @db.VarChar(255)
  mimeType             String       @map("mime_type") @db.VarChar(160)
  sizeBytes            Int          @map("size_bytes")
  storageKey           String       @map("storage_key") @db.VarChar(500)
  /// Sprint 6.1: durable object-storage key written at upload time (when available) so skills can read
  /// the original bytes for structured parsing. Null for legacy uploads that only have in-memory storage.
  objectStorageKey     String?      @map("object_storage_key") @db.VarChar(500)
  extractedText        String       @map("extracted_text") @db.Text
  createdAt            DateTime     @default(now()) @map("created_at")
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pluginInstallation   Plugin       @relation(fields: [pluginInstallationId], references: [id], onDelete: Cascade)
  conversation         Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdBy            User?        @relation("ConversationAttachmentCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, conversationId, createdAt])
  @@map("conversation_attachments")
}

model AgentExecution {
  id                        String               @id @default(uuid()) @db.Uuid
  organizationId            String               @map("organization_id") @db.Uuid
  conversationId            String               @map("conversation_id") @db.Uuid
  pluginInstallationId      String               @map("plugin_installation_id") @db.Uuid
  userId                    String?              @map("user_id") @db.Uuid
  status                    AgentExecutionStatus @default(QUEUED)
  modelProvider             String?              @map("model_provider") @db.VarChar(80)
  model                     String?              @db.VarChar(120)
  startedAt                 DateTime?            @map("started_at")
  completedAt               DateTime?            @map("completed_at")
  latencyMs                 Int?                 @map("latency_ms")
  inputTokens               Int                  @default(0) @map("input_tokens")
  outputTokens              Int                  @default(0) @map("output_tokens")
  totalTokens               Int                  @default(0) @map("total_tokens")
  estimatedCost             Decimal?             @map("estimated_cost") @db.Decimal(12, 6)
  errorCode                 String?              @map("error_code") @db.VarChar(100)
  errorMessage              String?              @map("error_message") @db.VarChar(500)
  requestId                 String?              @map("request_id") @db.VarChar(100)
  /// Sprint 4.7: the ExecutionTrace.traceId this execution belongs to — plain scalar, no FK, so trace
  /// retention (Phase 15) never restricts deleting/pruning this business record.
  traceId                   String?              @map("trace_id") @db.VarChar(64)
  metadata                  Json                 @default("{}")
  createdAt                 DateTime             @default(now()) @map("created_at")
  updatedAt                 DateTime             @updatedAt @map("updated_at")
  organization              Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation              Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  pluginInstallation        Plugin               @relation(fields: [pluginInstallationId], references: [id], onDelete: Restrict)
  user                      User?                @relation(fields: [userId], references: [id], onDelete: Restrict)
  toolExecutions            AgentToolExecution[]
  originatedSkillExecutions SkillExecution[]     @relation("SkillExecutionOrigin")
  latestSkillExecutions     SkillExecution[]     @relation("SkillExecutionLatest")
  skillRuns                 SkillRun[]

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([conversationId])
  @@index([organizationId, traceId])
  @@map("agent_executions")
}

/// Durable mirror of a multi-turn schema-driven skill lifecycle. During Phase 4 this row is strictly
/// observational: AgentMemory["travel.trip_state"] and the legacy Travel runtime remain authoritative.
model SkillExecution {
  id                          String               @id @default(uuid()) @db.Uuid
  organizationId              String               @map("organization_id") @db.Uuid
  pluginInstallationId        String               @map("plugin_installation_id") @db.Uuid
  conversationId              String               @map("conversation_id") @db.Uuid
  skillId                     String               @map("skill_id") @db.VarChar(160)
  skillVersion                String               @map("skill_version") @db.VarChar(50)
  schemaVersion               Int                  @map("schema_version")
  status                      SkillExecutionStatus @default(ACTIVE)
  state                       Json
  pendingInput                String?              @map("pending_input") @db.VarChar(100)
  originatingAgentExecutionId String?              @map("originating_agent_execution_id") @db.Uuid
  latestAgentExecutionId      String?              @map("latest_agent_execution_id") @db.Uuid
  revision                    Int                  @default(0)
  /// Stable request/turn identifiers already applied to this mirror, bounded by the persistence service.
  processedTurnIds            Json                 @default("[]") @map("processed_turn_ids")
  /// Non-null only while active; its unique constraint prevents two live executions for one scoped skill.
  activeKey                   String?              @unique @map("active_key") @db.VarChar(500)
  startedAt                   DateTime             @default(now()) @map("started_at")
  completedAt                 DateTime?            @map("completed_at")
  completionReason            String?              @map("completion_reason") @db.VarChar(160)
  createdAt                   DateTime             @default(now()) @map("created_at")
  updatedAt                   DateTime             @updatedAt @map("updated_at")
  organization                Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pluginInstallation          Plugin               @relation(fields: [pluginInstallationId], references: [id], onDelete: Restrict)
  conversation                Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  originatingAgentExecution   AgentExecution?      @relation("SkillExecutionOrigin", fields: [originatingAgentExecutionId], references: [id], onDelete: SetNull)
  latestAgentExecution        AgentExecution?      @relation("SkillExecutionLatest", fields: [latestAgentExecutionId], references: [id], onDelete: SetNull)

  @@index([organizationId, pluginInstallationId, conversationId, skillId])
  @@index([organizationId, status, updatedAt])
  @@index([conversationId, skillId, skillVersion])
  @@map("skill_executions")
}

/// Stage 9B: the smallest tenant- and plugin-installation-scoped persistence for a pending, multi-turn
/// business workflow (e.g. Contact Capture) that must resume before classification/RAG/capability
/// routing. Mirrors SkillExecution's revision/activeKey/processedTurnIds conventions for optimistic
/// locking, "one active workflow per conversation+type", and idempotent turn processing. Never stores
/// raw provider prompts or secrets — `state` holds only the typed, workflow-specific structured fields.
model WorkflowExecution {
  id                   String            @id @default(uuid()) @db.Uuid
  organizationId       String            @map("organization_id") @db.Uuid
  pluginInstallationId String            @map("plugin_installation_id") @db.Uuid
  conversationId       String            @map("conversation_id") @db.Uuid
  workflowType         WorkflowType      @map("workflow_type")
  status               WorkflowStatus    @default(ACTIVE)
  currentStep          String            @map("current_step") @db.VarChar(100)
  pendingInput         String?           @map("pending_input") @db.VarChar(100)
  state                Json
  revision             Int               @default(0)
  /// Stable request/turn identifiers already applied, bounded by the persistence service — idempotent
  /// replay of the same turn never re-transitions the workflow.
  processedTurnIds     Json              @default("[]") @map("processed_turn_ids")
  /// Non-null only while active; its unique constraint enforces one active workflow per
  /// organization+plugin installation+conversation+workflowType.
  activeKey            String?           @unique @map("active_key") @db.VarChar(500)
  /// Sprint 4.7: the ExecutionTrace.traceId this workflow was started under — plain scalar, no FK.
  traceId              String?           @map("trace_id") @db.VarChar(64)
  createdAt            DateTime          @default(now()) @map("created_at")
