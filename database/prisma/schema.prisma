/// A lead's progress through human follow-up, set by staff — the Conversation Completion framework itself
/// only ever creates a lead as NEW; it never advances status on its own.
enum TravelLeadStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED

  @@map("travel_lead_status")
}

/// Whether the best-effort external CRM mirror (see `TravelLeadService.createInternalLead` /
/// `AgentService.syncLeadToCrmBestEffort`) has run for this lead — purely observational. The internal
/// `TravelLead` row is always created first and is never rolled back or blocked by this outcome.
enum TravelLeadCrmSyncStatus {
  /// No CRM connector was configured, or the sync attempt hasn't run yet.
  PENDING
  /// Mirrored to the external CRM successfully.
  SYNCED
  /// The CRM connector threw, timed out, or rejected the payload — logged, never customer-facing.
  FAILED
  /// No CRM tool is available for this organization — mirroring was never attempted.
  SKIPPED

  @@map("travel_lead_crm_sync_status")
}

