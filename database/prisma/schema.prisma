generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  DISABLED

  @@map("organization_status")
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED

  @@map("user_status")
}

model Organization {
  id        String             @id @default(uuid()) @db.Uuid
  name      String             @db.VarChar(120)
  slug      String             @unique @db.VarChar(100)
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  users     User[]
  settings  OrganizationSetting?

  @@map("organizations")
}

model OrganizationSetting {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @unique @map("organization_id") @db.Uuid
  timezone        String       @db.VarChar(64)
  currency        String       @db.Char(3)
  locale          String       @db.VarChar(35)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

model User {
  id              String                  @id @default(uuid()) @db.Uuid
  organizationId  String                  @map("organization_id") @db.Uuid
  firstName       String                  @map("first_name") @db.VarChar(80)
  lastName        String?                 @map("last_name") @db.VarChar(80)
  email           String                  @db.VarChar(320)
  normalizedEmail String                  @unique @map("normalized_email") @db.VarChar(320)
  passwordHash    String                  @map("password_hash") @db.VarChar(255)
  role            UserRole
  status          UserStatus
  lastLoginAt     DateTime?               @map("last_login_at")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sessions        AuthenticationSession[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("users")
}

model AuthenticationSession {
  id                  String                 @id @default(uuid()) @db.Uuid
  userId              String                 @map("user_id") @db.Uuid
  tokenHash           String                 @map("token_hash") @db.VarChar(128)
  familyId            String                 @map("family_id") @db.Uuid
  expiresAt           DateTime               @map("expires_at")
  revokedAt           DateTime?              @map("revoked_at")
  replacedBySessionId String?                @unique @map("replaced_by_session_id") @db.Uuid
  lastUsedAt          DateTime?              @map("last_used_at")
  ipAddress           String?                @map("ip_address") @db.VarChar(64)
  userAgent           String?                @map("user_agent") @db.VarChar(512)
  createdAt           DateTime               @default(now()) @map("created_at")
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy          AuthenticationSession? @relation("SessionReplacement", fields: [replacedBySessionId], references: [id], onDelete: SetNull)
  replaces            AuthenticationSession? @relation("SessionReplacement")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@index([userId, revokedAt])
  @@map("authentication_sessions")
}
