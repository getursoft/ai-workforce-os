  status                    AgentExecutionStatus @default(QUEUED)
  modelProvider             String?              @map("model_provider") @db.VarChar(80)
  model                     String?              @db.VarChar(120)
  startedAt                 DateTime?            @map("started_at")
  completedAt               DateTime?            @map("completed_at")
  latencyMs                 Int?                 @map("latency_ms")
  inputTokens               Int                  @default(0) @map("input_tokens")
  outputTokens              Int                  @default(0) @map("output_tokens")
  totalTokens               Int                  @default(0) @map("total_tokens")
  estimatedCost             Decimal?             @map("estimated_cost") @db.Decimal(12, 6)
  errorCode                 String?              @map("error_code") @db.VarChar(100)
  errorMessage              String?              @map("error_message") @db.VarChar(500)
  requestId                 String?              @map("request_id") @db.VarChar(100)
  metadata                  Json                 @default("{}")
  createdAt                 DateTime             @default(now()) @map("created_at")
  updatedAt                 DateTime             @updatedAt @map("updated_at")
  organization              Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
