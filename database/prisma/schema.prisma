/// Stage 9B: reusable, typed pending-workflow persistence — the smallest general mechanism for a
/// multi-turn business workflow that must resume before intent classification / RAG / capability
/// routing. CONTACT_CAPTURE is the first (and, for this stage, only) workflow using it.
enum WorkflowType {
  CONTACT_CAPTURE
  BOOKING_HANDOFF
  TRIP_SUBMISSION
  /// Sprint 4.6: wraps a delegated task that itself requires human approval (see EmployeeDelegatedTask).
  EMPLOYEE_DELEGATION
  /// Sprint 4.8: durable tracking of an autonomous reminder/follow-up executed by the Scheduler. Only the
  /// generic persistence (WorkflowExecutionService) is used — never WorkflowCoordinator turn dispatch, so
  /// this is purely additive to the Workflow Engine.
  AUTONOMOUS_REMINDER

  @@map("workflow_type")
}

/// Sprint 4.8 — Autonomous Scheduler & Background Execution Engine. Lifecycle of a ScheduledJob row.
enum ScheduledJobStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  FAILED

  @@map("scheduled_job_status")
}

/// Sprint 4.8 — how a ScheduledJob is triggered. ONE_TIME/DATE fire at an exact point in time;
/// CRON/INTERVAL/DAILY/WEEKLY/MONTHLY recur; EVENT and AFTER_* are fired by the scheduler event bus (with
/// a reconciliation scan as a crash-recovery fallback) whenever a matching domain event occurs.
enum ScheduledJobTriggerType {
  ONE_TIME
  CRON
  INTERVAL
  DAILY
  WEEKLY
  MONTHLY
  EVENT
  DATE
  AFTER_APPROVAL
  AFTER_BOOKING
  AFTER_WORKFLOW
  AFTER_PAYMENT
  AFTER_UPLOAD

  @@map("scheduled_job_trigger_type")
}

/// Sprint 4.8 — scheduling/runtime priority. Dispatcher claims QUEUED executions in priority order so
/// URGENT/CRITICAL follow-ups are never starved behind routine reminders.
enum ScheduledJobPriority {
  LOW
  NORMAL
  HIGH
  URGENT
  CRITICAL

  @@map("scheduled_job_priority")
}

/// Sprint 4.8 — lifecycle of one ScheduledExecution (one run of a ScheduledJob). Mirrors the statuses the
/// sprint mandates: RUNNING, QUEUED, FAILED, RETRYING, COMPLETED, CANCELLED, TIMEOUT (plus DEAD_LETTERED
/// for executions that exhausted their retry budget and were parked on the dead letter queue).
enum ScheduledExecutionStatus {
  QUEUED
  RUNNING
  FAILED
  RETRYING
  COMPLETED
  CANCELLED
  TIMEOUT
  DEAD_LETTERED

  @@map("scheduled_execution_status")
}

