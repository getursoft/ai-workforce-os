/// A travel enquiry captured through the Conversation Completion & Lead Capture framework (see
/// `apps/api/src/conversation/conversation-completion.ts`) — created only after the traveler has
/// explicitly consented and provided a phone number, never silently. This is a guaranteed, always-on
/// capture path independent of any external CRM connector (contrast with the connector-backed
/// `crm.create_lead` tool / `DummyCrmLead`, which stays optional and org-configured). Every future AI
/// Employee that adopts the same framework owns its own equivalent model (SalesLead, HospitalAppointment,
/// ...) with the same `conversationId` + `reference` + `status` + `source` shape.
model TravelLead {
  id                   String                  @id @default(uuid()) @db.Uuid
  organizationId       String                  @map("organization_id") @db.Uuid
  pluginInstallationId String                  @map("plugin_installation_id") @db.Uuid
  conversationId       String                  @map("conversation_id") @db.Uuid
  /// The in-memory multi-city Journey.id this lead was captured for, if any — null for a plain single-leg
  /// trip. Part of the idempotency key (see `idempotencyKey`): a genuinely new journey always gets its own
  /// lead, while repeated capture attempts for the SAME journey collapse onto the same row.
  journeyId            String?                 @map("journey_id") @db.VarChar(64)
  /// Short human-readable reference shown to the traveler (e.g. "TRV-4F2B91") — see `generateLeadReference`.
  reference            String                  @unique @db.VarChar(20)
  customerName         String?                 @map("customer_name") @db.VarChar(160)
  phoneNumber          String                  @map("phone_number") @db.VarChar(24)
  email                String?                 @db.VarChar(160)
  departureCity        String?                 @map("departure_city") @db.VarChar(160)
  /// The complete current route, including every multi-city leg (e.g. "Delhi -> London -> New York ->
  /// Delhi") — never just the currently active leg. A plain single-leg trip stores just the destination.
  destination          String?                 @db.VarChar(160)
  travelDates          String?                 @map("travel_dates") @db.VarChar(160)
  passengers           String?                 @db.VarChar(80)
  tripPurpose          String?                 @map("trip_purpose") @db.VarChar(120)
  budgetAmount         Decimal?                @map("budget_amount") @db.Decimal(12, 2)
  budgetCurrency       String?                 @map("budget_currency") @db.VarChar(8)
  /// The traveler's chosen DISPLAY currency for cost figures, if different from `budgetCurrency` — see
  /// `TravelConversationMemory.displayCurrency`.
  displayCurrency      String?                 @map("display_currency") @db.VarChar(8)
  conversationSummary  String                  @map("conversation_summary") @db.Text
  /// Set once, at creation — every lead-capture entry point only ever calls `TravelLeadService.
  /// createInternalLead` after consent + contact details were already collected, so consent is implicit in
  /// the row existing at all; this timestamp records exactly when.
  consentGivenAt       DateTime?               @map("consent_given_at")
  /// Tenant-scoped dedup key: `organizationId:conversationId:journeyId (or "single"):LEAD_CAPTURE` — see
  /// `TravelLeadService.buildIdempotencyKey`. Nullable+unique so older rows (predating this column) are
  /// unaffected; every new row always sets one.
  idempotencyKey       String?                 @unique @map("idempotency_key") @db.VarChar(300)
  status               TravelLeadStatus        @default(NEW)
  /// Best-effort external CRM mirror outcome — see `TravelLeadCrmSyncStatus`. Never gates or rolls back
  /// this row; purely observational.
  crmSyncStatus        TravelLeadCrmSyncStatus @default(PENDING) @map("crm_sync_status")
  source               String                  @default("TravelEmployee") @db.VarChar(60)
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")
