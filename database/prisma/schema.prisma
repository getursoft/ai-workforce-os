generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  DISABLED

  @@map("organization_status")
}

enum LegacyUserRole {
  OWNER
  ADMIN
  MEMBER

  @@map("legacy_user_role")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED

  @@map("user_status")
}

enum TeamStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@map("team_status")
}

enum TeamMemberRole {
  MANAGER
  LEAD
  MEMBER

  @@map("team_member_role")
}

enum ServiceAccountStatus {
  ACTIVE
  DISABLED
  ARCHIVED

  @@map("service_account_status")
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED

  @@map("api_key_status")
}

enum ApiKeyEnvironment {
  LIVE
  TEST
  DEVELOPMENT

  @@map("api_key_environment")
}

enum PluginStatus {
  ACTIVE
  DISABLED
  DEPRECATED
  FAILED

  @@map("plugin_status")
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED

  @@map("conversation_status")
}

enum ConversationMessageRole {
  SYSTEM
  USER
  ASSISTANT
  TOOL

  @@map("conversation_message_role")
}

enum AgentExecutionStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  TIMED_OUT

  @@map("agent_execution_status")
}

enum AgentToolExecutionStatus {
  REQUESTED
  RUNNING
  COMPLETED
  FAILED
  DENIED
  TIMED_OUT

  @@map("agent_tool_execution_status")
}

enum AgentMemoryScope {
  USER
  CONVERSATION
  PLUGIN
  ORGANIZATION

  @@map("agent_memory_scope")
}

enum PluginAiProviderType {
  DETERMINISTIC
  OPENAI_COMPATIBLE
  AZURE_OPENAI

  @@map("plugin_ai_provider_type")
}

enum ConnectorAuthType {
  NONE
  API_KEY
  BEARER_TOKEN
  BASIC_AUTH
  OAUTH2
  CUSTOM

  @@map("connector_auth_type")
}

enum ConnectorDefinitionStatus {
  ACTIVE
  DEPRECATED
  DISABLED

  @@map("connector_definition_status")
}

enum ConnectorInstallationStatus {
  DRAFT
  CONNECTED
  READY
  DISABLED
  AUTH_FAILED
  EXPIRED
  DEGRADED
  FAILED
  DISCONNECTED
  ARCHIVED

  @@map("connector_installation_status")
}

enum ConnectorHealthStatus {
  UNKNOWN
  READY
  DEGRADED
  FAILED
  AUTH_FAILED
  EXPIRED
  RATE_LIMITED
  DISCONNECTED

  @@map("connector_health_status")
}

enum ConnectorRiskLevel {
  LOW
  MEDIUM
  HIGH

  @@map("connector_risk_level")
}

enum ConnectorOperationType {
  READ
  WRITE

  @@map("connector_operation_type")
}

enum ConnectorExecutionStatus {
  RUNNING
  SUCCEEDED
  FAILED
  DENIED
  TIMED_OUT

  @@map("connector_execution_status")
}

enum ConnectorActorType {
  USER
  SERVICE_ACCOUNT
  AGENT
  SYSTEM

  @@map("connector_actor_type")
}

enum ConnectorEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
  DUPLICATE

  @@map("connector_event_status")
}

enum KnowledgeDocumentStatus {
  UPLOADED
  PROCESSING
  INDEXED
  FAILED

  @@map("knowledge_document_status")
}

enum ChannelProvider {
  TWILIO

  @@map("channel_provider")
}

enum ChannelType {
  WHATSAPP

  @@map("channel_type")
}

enum ChannelConnectionStatus {
  DRAFT
  ACTIVE
  DISABLED

  @@map("channel_connection_status")
}

enum ChannelMessageDirection {
  INBOUND
  OUTBOUND

  @@map("channel_message_direction")
}

enum ChannelMessageStatus {
  RECEIVED
  PROCESSING
  SENT
  FAILED

  @@map("channel_message_status")
}

model Organization {
  id                     String                  @id @default(uuid()) @db.Uuid
  name                   String                  @db.VarChar(120)
  slug                   String                  @unique @db.VarChar(100)
  status                 OrganizationStatus      @default(ACTIVE)
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  users                  User[]
  settings               OrganizationSetting?
  roles                  Role[]
  invitations            Invitation[]
  teams                  Team[]
  serviceAccounts        ServiceAccount[]
  plugins                Plugin[]
  pluginConfigurations   PluginConfiguration[]
  conversations          Conversation[]
  agentExecutions        AgentExecution[]
  agentToolExecutions    AgentToolExecution[]
  agentMemories          AgentMemory[]
  pluginAiConfigurations PluginAiConfiguration[]
  connectorInstallations ConnectorInstallation[]
  connectorExecutions    ConnectorExecution[]
  connectorEvents        ConnectorEvent[]
  connectorAuditEvents   ConnectorAuditEvent[]
  dummyCrmLeads          DummyCrmLead[]
  knowledgeDocuments     KnowledgeDocument[]
  knowledgeChunks        KnowledgeChunk[]
  channelConnections     ChannelConnection[]
  channelMessages        ChannelMessage[]
  travelEmployeeConfigurations TravelEmployeeConfiguration[]

  @@map("organizations")
}

model OrganizationSetting {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @unique @map("organization_id") @db.Uuid
  timezone       String       @db.VarChar(64)
  currency       String       @db.Char(3)
  locale         String       @db.VarChar(35)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

model User {
  id                            String                  @id @default(uuid()) @db.Uuid
  organizationId                String                  @map("organization_id") @db.Uuid
  firstName                     String                  @map("first_name") @db.VarChar(80)
  lastName                      String?                 @map("last_name") @db.VarChar(80)
  email                         String                  @db.VarChar(320)
  normalizedEmail               String                  @unique @map("normalized_email") @db.VarChar(320)
  passwordHash                  String                  @map("password_hash") @db.VarChar(255)
  role                          LegacyUserRole
  status                        UserStatus
  lastLoginAt                   DateTime?               @map("last_login_at")
  createdAt                     DateTime                @default(now()) @map("created_at")
  updatedAt                     DateTime                @updatedAt @map("updated_at")
  organization                  Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sessions                      AuthenticationSession[]
  userRoles                     UserRole[]
  invitationsSent               Invitation[]            @relation("InvitationSender")
  managedTeams                  Team[]                  @relation("TeamManager")
  teamMemberships               TeamMember[]
  serviceAccountsCreated        ServiceAccount[]        @relation("ServiceAccountCreator")
  apiKeysCreated                ApiKey[]                @relation("ApiKeyCreator")
  apiKeysRevoked                ApiKey[]                @relation("ApiKeyRevoker")
  pluginConfigurationsUpdated   PluginConfiguration[]   @relation("PluginConfigurationUpdater")
  conversationsCreated          Conversation[]
  agentExecutions               AgentExecution[]
  agentMemories                 AgentMemory[]
  pluginAiConfigurationsUpdated PluginAiConfiguration[] @relation("PluginAiConfigurationUpdater")
  connectorInstallationsCreated ConnectorInstallation[] @relation("ConnectorInstallationCreator")
  connectorAuditEvents          ConnectorAuditEvent[]
  knowledgeDocumentsUploaded    KnowledgeDocument[]     @relation("KnowledgeDocumentUploader")
  channelConnectionsCreated     ChannelConnection[]     @relation("ChannelConnectionCreator")
  travelEmployeeConfigurationsCreated TravelEmployeeConfiguration[] @relation("TravelEmployeeConfigurationCreator")
  deletedAt                     DateTime?               @map("deleted_at")

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("users")
}

model KnowledgeDocument {
  id               String                  @id @default(uuid()) @db.Uuid
  organizationId   String                  @map("organization_id") @db.Uuid
  title            String                  @db.VarChar(200)
  originalFilename String                  @map("original_filename") @db.VarChar(255)
  mimeType         String                  @map("mime_type") @db.VarChar(160)
  fileSizeBytes    Int                     @map("file_size_bytes")
  storageKey       String?                 @map("storage_key") @db.VarChar(500)
  extractedText    String?                 @map("extracted_text") @db.Text
  status           KnowledgeDocumentStatus @default(UPLOADED)
  processingError  String?                 @map("processing_error") @db.VarChar(500)
  chunkCount       Int                     @default(0) @map("chunk_count")
  uploadedByUserId String                  @map("uploaded_by_user_id") @db.Uuid
  indexedAt        DateTime?               @map("indexed_at")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  deletedAt        DateTime?               @map("deleted_at")
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy       User                    @relation("KnowledgeDocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  chunks           KnowledgeChunk[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, deletedAt])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  documentId     String            @map("document_id") @db.Uuid
  chunkIndex     Int               @map("chunk_index")
  content        String            @db.Text
  tokenCount     Int               @map("token_count")
  pageNumber     Int?              @map("page_number")
  sectionTitle   String?           @map("section_title") @db.VarChar(255)
  embeddingJson  Json?             @map("embedding_json")
  embeddingModel String?           @map("embedding_model") @db.VarChar(160)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document       KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([organizationId, documentId])
  @@index([organizationId, createdAt])
  @@map("knowledge_chunks")
}

model Plugin {
  id                  String                 @id @default(uuid()) @db.Uuid
  organizationId      String                 @map("organization_id") @db.Uuid
  name                String                 @db.VarChar(120)
  slug                String                 @db.VarChar(100)
  version             String                 @db.VarChar(50)
  displayName         String                 @map("display_name") @db.VarChar(160)
  description         String                 @db.VarChar(1000)
  author              String                 @db.VarChar(160)
  status              PluginStatus           @default(DISABLED)
  entryPoint          String                 @map("entry_point") @db.VarChar(120)
  manifest            Json
  configSchema        Json?                  @map("config_schema")
  grantedPermissions  Json                   @default("[]") @map("granted_permissions")
  installedAt         DateTime               @default(now()) @map("installed_at")
  enabledAt           DateTime?              @map("enabled_at")
  disabledAt          DateTime?              @map("disabled_at")
  lastStartedAt       DateTime?              @map("last_started_at")
  lastStoppedAt       DateTime?              @map("last_stopped_at")
  lastHealthStatus    String?                @map("last_health_status") @db.VarChar(32)
  lastHealthCheckedAt DateTime?              @map("last_health_checked_at")
  lastErrorCode       String?                @map("last_error_code") @db.VarChar(100)
  lastErrorMessage    String?                @map("last_error_message") @db.VarChar(500)
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  deletedAt           DateTime?              @map("deleted_at")
  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  configuration       PluginConfiguration?
  conversations       Conversation[]
  agentExecutions     AgentExecution[]
  agentMemories       AgentMemory[]
  aiConfiguration     PluginAiConfiguration?
  channelConnections  ChannelConnection[]
  travelEmployeeConfiguration TravelEmployeeConfiguration?

  @@index([organizationId, slug])
  @@index([organizationId])
  @@index([organizationId, status, deletedAt])
  @@index([organizationId, deletedAt])
  @@map("plugins")
}

model Conversation {
  id                  String                @id @default(uuid()) @db.Uuid
  organizationId      String                @map("organization_id") @db.Uuid
  pluginInstallationId String               @map("plugin_installation_id") @db.Uuid
  createdByUserId     String?               @map("created_by_user_id") @db.Uuid
  channelConnectionId String?               @map("channel_connection_id") @db.Uuid
  externalUserId      String?               @map("external_user_id") @db.VarChar(64)
  title               String                @db.VarChar(160)
  status              ConversationStatus    @default(ACTIVE)
  metadata            Json                  @default("{}")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  deletedAt           DateTime?             @map("deleted_at")
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pluginInstallation  Plugin                @relation(fields: [pluginInstallationId], references: [id], onDelete: Restrict)
  createdBy           User?                 @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  channelConnection   ChannelConnection?    @relation(fields: [channelConnectionId], references: [id], onDelete: Cascade)
  messages            ConversationMessage[]
  executions          AgentExecution[]
  memories            AgentMemory[]
  channelMessages     ChannelMessage[]

  @@index([organizationId, status, updatedAt])
  @@index([organizationId, pluginInstallationId])
  @@index([organizationId, channelConnectionId, externalUserId, status])
  @@map("conversations")
}

model ConversationMessage {
  id              String                  @id @default(uuid()) @db.Uuid
  conversationId  String                  @map("conversation_id") @db.Uuid
  organizationId  String                  @map("organization_id") @db.Uuid
  toolExecutionId String?                 @map("tool_execution_id") @db.Uuid
  role            ConversationMessageRole
  content         String                  @db.Text
  contentJson     Json?                   @map("content_json")
  model           String?                 @db.VarChar(120)
  inputTokens     Int?                    @map("input_tokens")
  outputTokens    Int?                    @map("output_tokens")
  createdAt       DateTime                @default(now()) @map("created_at")
  conversation    Conversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  toolExecution   AgentToolExecution?     @relation(fields: [toolExecutionId], references: [id], onDelete: SetNull)

  @@index([organizationId, conversationId, createdAt])
  @@index([toolExecutionId])
  @@map("conversation_messages")
}

model AgentExecution {
  id                   String               @id @default(uuid()) @db.Uuid
  organizationId       String               @map("organization_id") @db.Uuid
  conversationId       String               @map("conversation_id") @db.Uuid
  pluginInstallationId String               @map("plugin_installation_id") @db.Uuid
  userId               String?              @map("user_id") @db.Uuid
  status               AgentExecutionStatus @default(QUEUED)
  modelProvider        String?              @map("model_provider") @db.VarChar(80)
  model                String?              @db.VarChar(120)
  startedAt            DateTime?            @map("started_at")
  completedAt          DateTime?            @map("completed_at")
  latencyMs            Int?                 @map("latency_ms")
  inputTokens          Int                  @default(0) @map("input_tokens")
  outputTokens         Int                  @default(0) @map("output_tokens")
  totalTokens          Int                  @default(0) @map("total_tokens")
  estimatedCost        Decimal?             @map("estimated_cost") @db.Decimal(12, 6)
  errorCode            String?              @map("error_code") @db.VarChar(100)
  errorMessage         String?              @map("error_message") @db.VarChar(500)
  requestId            String?              @map("request_id") @db.VarChar(100)
  metadata             Json                 @default("{}")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation         Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  pluginInstallation   Plugin               @relation(fields: [pluginInstallationId], references: [id], onDelete: Restrict)
  user                 User?                @relation(fields: [userId], references: [id], onDelete: Restrict)
  toolExecutions       AgentToolExecution[]

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([conversationId])
  @@map("agent_executions")
}

model AgentToolExecution {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  executionId    String                   @map("execution_id") @db.Uuid
  toolName       String                   @map("tool_name") @db.VarChar(160)
  toolVersion    String                   @map("tool_version") @db.VarChar(50)
  status         AgentToolExecutionStatus @default(REQUESTED)
  input          Json
  output         Json?
  errorCode      String?                  @map("error_code") @db.VarChar(100)
  errorMessage   String?                  @map("error_message") @db.VarChar(500)
  startedAt      DateTime?                @map("started_at")
  completedAt    DateTime?                @map("completed_at")
  latencyMs      Int?                     @map("latency_ms")
  createdAt      DateTime                 @default(now()) @map("created_at")
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  execution      AgentExecution           @relation(fields: [executionId], references: [id], onDelete: Cascade)
  messages       ConversationMessage[]

  @@index([organizationId, executionId])
  @@map("agent_tool_executions")
}

model AgentMemory {
  id                   String           @id @default(uuid()) @db.Uuid
  organizationId       String           @map("organization_id") @db.Uuid
  pluginInstallationId String           @map("plugin_installation_id") @db.Uuid
  userId               String?          @map("user_id") @db.Uuid
  conversationId       String?          @map("conversation_id") @db.Uuid
  scope                AgentMemoryScope
  key                  String           @db.VarChar(160)
  value                Json
  searchableText       String?          @map("searchable_text") @db.Text
  metadata             Json             @default("{}")
  expiresAt            DateTime?        @map("expires_at")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")
  deletedAt            DateTime?        @map("deleted_at")
  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pluginInstallation   Plugin           @relation(fields: [pluginInstallationId], references: [id], onDelete: Cascade)
  user                 User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation         Conversation?    @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, pluginInstallationId, userId, conversationId, scope, key])
  @@index([organizationId, pluginInstallationId, scope])
  @@index([organizationId, userId, deletedAt])
  @@map("agent_memories")
}

model PluginConfiguration {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  pluginId         String       @unique @map("plugin_id") @db.Uuid
  config           Json
  encryptedSecrets Json         @map("encrypted_secrets")
  updatedBy        String       @map("updated_by") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plugin           Plugin       @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  updater          User         @relation("PluginConfigurationUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([organizationId, pluginId])
  @@map("plugin_configurations")
}

model PluginAiConfiguration {
  id                   String               @id @default(uuid()) @db.Uuid
  organizationId       String               @map("organization_id") @db.Uuid
  pluginInstallationId String               @unique @map("plugin_installation_id") @db.Uuid
  providerType         PluginAiProviderType @map("provider_type")
  configuration        Json
  encryptedSecrets     Json                 @map("encrypted_secrets")
  encryptionVersion    Int                  @default(1) @map("encryption_version")
  updatedBy            String               @map("updated_by") @db.Uuid
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pluginInstallation   Plugin               @relation(fields: [pluginInstallationId], references: [id], onDelete: Cascade)
  updater              User                 @relation("PluginAiConfigurationUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@index([organizationId, providerType])
  @@index([organizationId, pluginInstallationId])
  @@map("plugin_ai_configurations")
}

model Team {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(120)
  slug           String       @db.VarChar(140)
  description    String?      @db.VarChar(500)
  managerId      String?      @map("manager_id") @db.Uuid
  parentTeamId   String?      @map("parent_team_id") @db.Uuid
  status         TeamStatus   @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  manager        User?        @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  parentTeam     Team?        @relation("TeamHierarchy", fields: [parentTeamId], references: [id], onDelete: SetNull)
  childTeams     Team[]       @relation("TeamHierarchy")
  members        TeamMember[]

  @@unique([organizationId, slug])
  @@index([organizationId, status, deletedAt])
  @@index([managerId])
  @@index([parentTeamId])
  @@map("teams")
}

model TeamMember {
  teamId    String         @map("team_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  role      TeamMemberRole @default(MEMBER)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  team      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model Role {
  id                  String               @id @default(uuid()) @db.Uuid
  organizationId      String               @map("organization_id") @db.Uuid
  name                String               @db.VarChar(80)
  description         String?              @db.VarChar(255)
  isSystem            Boolean              @default(false) @map("is_system")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions         RolePermission[]
  users               UserRole[]
  serviceAccountRoles ServiceAccountRole[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(100)
  description String?          @db.VarChar(255)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model ServiceAccount {
  id              String               @id @default(uuid()) @db.Uuid
  organizationId  String               @map("organization_id") @db.Uuid
  name            String               @db.VarChar(120)
  description     String?              @db.VarChar(500)
  status          ServiceAccountStatus @default(ACTIVE)
  createdByUserId String               @map("created_by_user_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  deletedAt       DateTime?            @map("deleted_at")
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User                 @relation("ServiceAccountCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  apiKeys         ApiKey[]
  roles           ServiceAccountRole[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("service_accounts")
}

model ApiKey {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  serviceAccountId String            @map("service_account_id") @db.Uuid
  name             String            @db.VarChar(120)
  keyPrefix        String            @map("key_prefix") @db.VarChar(16)
  publicId         String            @unique @map("public_id") @db.VarChar(32)
  maskedValue      String            @map("masked_value") @db.VarChar(80)
  secretHash       String            @map("secret_hash") @db.Char(64)
  hashVersion      Int               @default(1) @map("hash_version")
  environment      ApiKeyEnvironment
  status           ApiKeyStatus      @default(ACTIVE)
  expiresAt        DateTime?         @map("expires_at")
  lastUsedAt       DateTime?         @map("last_used_at")
  revokedAt        DateTime?         @map("revoked_at")
  createdByUserId  String            @map("created_by_user_id") @db.Uuid
  revokedByUserId  String?           @map("revoked_by_user_id") @db.Uuid
  replacementKeyId String?           @unique @map("replacement_key_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  serviceAccount   ServiceAccount    @relation(fields: [serviceAccountId], references: [id], onDelete: Cascade)
  createdBy        User              @relation("ApiKeyCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  revokedBy        User?             @relation("ApiKeyRevoker", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  replacementKey   ApiKey?           @relation("ApiKeyRotation", fields: [replacementKeyId], references: [id], onDelete: SetNull)
  replaces         ApiKey?           @relation("ApiKeyRotation")

  @@index([publicId])
  @@index([organizationId, status])
  @@index([serviceAccountId])
  @@map("api_keys")
}

model ServiceAccountRole {
  serviceAccountId String         @map("service_account_id") @db.Uuid
  roleId           String         @map("role_id") @db.Uuid
  assignedAt       DateTime       @default(now()) @map("assigned_at")
  serviceAccount   ServiceAccount @relation(fields: [serviceAccountId], references: [id], onDelete: Cascade)
  role             Role           @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([serviceAccountId, roleId])
  @@index([roleId])
  @@map("service_account_roles")
}

model Invitation {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  email           String       @db.VarChar(320)
  normalizedEmail String       @map("normalized_email") @db.VarChar(320)
  tokenHash       String       @unique @map("token_hash") @db.Char(64)
  roleIds         Json         @map("role_ids")
  invitedById     String       @map("invited_by_id") @db.Uuid
  expiresAt       DateTime     @map("expires_at")
  acceptedAt      DateTime?    @map("accepted_at")
  revokedAt       DateTime?    @map("revoked_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy       User         @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([organizationId, normalizedEmail])
  @@index([expiresAt])
  @@map("invitations")
}

model AuthenticationSession {
  id                  String                 @id @default(uuid()) @db.Uuid
  userId              String                 @map("user_id") @db.Uuid
  tokenHash           String                 @map("token_hash") @db.VarChar(128)
  familyId            String                 @map("family_id") @db.Uuid
  expiresAt           DateTime               @map("expires_at")
  revokedAt           DateTime?              @map("revoked_at")
  replacedBySessionId String?                @unique @map("replaced_by_session_id") @db.Uuid
  lastUsedAt          DateTime?              @map("last_used_at")
  ipAddress           String?                @map("ip_address") @db.VarChar(64)
  userAgent           String?                @map("user_agent") @db.VarChar(512)
  createdAt           DateTime               @default(now()) @map("created_at")
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy          AuthenticationSession? @relation("SessionReplacement", fields: [replacedBySessionId], references: [id], onDelete: SetNull)
  replaces            AuthenticationSession? @relation("SessionReplacement")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@index([userId, revokedAt])
  @@map("authentication_sessions")
}

model ConnectorDefinition {
  id                   String                    @id @default(uuid()) @db.Uuid
  key                  String                    @unique @db.VarChar(100)
  name                 String                    @db.VarChar(160)
  description          String                    @db.VarChar(1000)
  category             String                    @db.VarChar(80)
  version              String                    @db.VarChar(50)
  authType             ConnectorAuthType         @map("auth_type")
  manifest             Json
  declaredCapabilities Json                      @map("declared_capabilities")
  configurationSchema  Json                      @map("configuration_schema")
  credentialSchema     Json                      @map("credential_schema")
  status               ConnectorDefinitionStatus @default(ACTIVE)
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")
  tools                ConnectorTool[]
  installations        ConnectorInstallation[]

  @@index([status, category])
  @@map("connector_definitions")
}

model ConnectorTool {
  id                 String                 @id @default(uuid()) @db.Uuid
  connectorId        String                 @map("connector_id") @db.Uuid
  name               String                 @db.VarChar(120)
  displayName        String                 @map("display_name") @db.VarChar(160)
  description        String                 @db.VarChar(1000)
  inputSchema        Json                   @map("input_schema")
  outputSchema       Json?                  @map("output_schema")
  requiredCapability String                 @map("required_capability") @db.VarChar(120)
  operationType      ConnectorOperationType @map("operation_type")
  riskLevel          ConnectorRiskLevel     @map("risk_level")
  timeoutMs          Int                    @default(10000) @map("timeout_ms")
  enabled            Boolean                @default(true)
  connector          ConnectorDefinition    @relation(fields: [connectorId], references: [id], onDelete: Cascade)

  @@unique([connectorId, name])
  @@index([connectorId, enabled])
  @@map("connector_tools")
}

model ConnectorInstallation {
  id                   String                      @id @default(uuid()) @db.Uuid
  organizationId       String                      @map("organization_id") @db.Uuid
  connectorId          String                      @map("connector_id") @db.Uuid
  displayName          String                      @map("display_name") @db.VarChar(160)
  status               ConnectorInstallationStatus @default(DRAFT)
  configuration        Json                        @default("{}")
  encryptedCredentials Json                        @map("encrypted_credentials")
  credentialMetadata   Json                        @default("{}") @map("credential_metadata")
  grantedCapabilities  Json                        @default("[]") @map("granted_capabilities")
  lastHealthStatus     ConnectorHealthStatus       @default(UNKNOWN) @map("last_health_status")
  lastHealthCheckedAt  DateTime?                   @map("last_health_checked_at")
  lastErrorCode        String?                     @map("last_error_code") @db.VarChar(100)
  lastErrorMessage     String?                     @map("last_error_message") @db.VarChar(500)
  credentialExpiresAt  DateTime?                   @map("credential_expires_at")
  createdByUserId      String                      @map("created_by_user_id") @db.Uuid
  createdAt            DateTime                    @default(now()) @map("created_at")
  updatedAt            DateTime                    @updatedAt @map("updated_at")
  deletedAt            DateTime?                   @map("deleted_at")
  organization         Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connector            ConnectorDefinition         @relation(fields: [connectorId], references: [id], onDelete: Restrict)
  createdBy            User                        @relation("ConnectorInstallationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  executions           ConnectorExecution[]
  events               ConnectorEvent[]
  auditEvents          ConnectorAuditEvent[]
  dummyCrmLeads        DummyCrmLead[]

  @@index([organizationId, status, deletedAt])
  @@index([organizationId, connectorId])
  @@map("connector_installations")
}

model ConnectorExecution {
  id                      String                   @id @default(uuid()) @db.Uuid
  organizationId          String                   @map("organization_id") @db.Uuid
  connectorInstallationId String                   @map("connector_installation_id") @db.Uuid
  agentExecutionId        String?                  @map("agent_execution_id") @db.Uuid
  toolName                String                   @map("tool_name") @db.VarChar(180)
  actorType               ConnectorActorType       @map("actor_type")
  actorId                 String?                  @map("actor_id") @db.Uuid
  requestMetadata         Json                     @default("{}") @map("request_metadata")
  input                   Json
  output                  Json?
  status                  ConnectorExecutionStatus @default(RUNNING)
  latencyMs               Int?                     @map("latency_ms")
  externalStatusCode      Int?                     @map("external_status_code")
  errorCode               String?                  @map("error_code") @db.VarChar(100)
  errorMessage            String?                  @map("error_message") @db.VarChar(500)
  createdAt               DateTime                 @default(now()) @map("created_at")
  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectorInstallation   ConnectorInstallation    @relation(fields: [connectorInstallationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([connectorInstallationId, createdAt])
  @@index([agentExecutionId])
  @@map("connector_executions")
}

model ConnectorEvent {
  id                      String                @id @default(uuid()) @db.Uuid
  organizationId          String                @map("organization_id") @db.Uuid
  connectorInstallationId String                @map("connector_installation_id") @db.Uuid
  eventType               String                @map("event_type") @db.VarChar(120)
  externalEventId         String                @map("external_event_id") @db.VarChar(255)
  payload                 Json
  status                  ConnectorEventStatus  @default(RECEIVED)
  receivedAt              DateTime              @default(now()) @map("received_at")
  processedAt             DateTime?             @map("processed_at")
  errorCode               String?               @map("error_code") @db.VarChar(100)
  errorMessage            String?               @map("error_message") @db.VarChar(500)
  organization            Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectorInstallation   ConnectorInstallation @relation(fields: [connectorInstallationId], references: [id], onDelete: Cascade)

  @@unique([connectorInstallationId, externalEventId])
  @@index([organizationId, receivedAt])
  @@index([connectorInstallationId, status])
  @@map("connector_events")
}

model ConnectorAuditEvent {
  id                      String                 @id @default(uuid()) @db.Uuid
  organizationId          String                 @map("organization_id") @db.Uuid
  connectorInstallationId String?                @map("connector_installation_id") @db.Uuid
  userId                  String?                @map("user_id") @db.Uuid
  event                   String                 @db.VarChar(120)
  requestId               String                 @map("request_id") @db.VarChar(100)
  metadata                Json                   @default("{}")
  createdAt               DateTime               @default(now()) @map("created_at")
  organization            Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectorInstallation   ConnectorInstallation? @relation(fields: [connectorInstallationId], references: [id], onDelete: SetNull)
  user                    User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([connectorInstallationId, createdAt])
  @@map("connector_audit_events")
}

model DummyCrmLead {
