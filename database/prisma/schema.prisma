model ChannelMessage {
  id                  String                  @id @default(uuid()) @db.Uuid
  organizationId      String                  @map("organization_id") @db.Uuid
  channelConnectionId String                  @map("channel_connection_id") @db.Uuid
  conversationId      String?                 @map("conversation_id") @db.Uuid
  agentExecutionId    String?                 @map("agent_execution_id") @db.Uuid
  provider            ChannelProvider
  direction           ChannelMessageDirection
  status              ChannelMessageStatus    @default(RECEIVED)
  providerMessageSid  String?                 @map("provider_message_sid") @db.VarChar(100)
  fromAddress         String                  @map("from_address") @db.VarChar(64)
  toAddress           String                  @map("to_address") @db.VarChar(64)
  body                String?                 @db.Text
  mediaMetadata       Json                    @default("[]") @map("media_metadata")
  errorCode           String?                 @map("error_code") @db.VarChar(100)
  errorMessage        String?                 @map("error_message") @db.VarChar(500)
  processingAttempts  Int                     @default(0) @map("processing_attempts")
  nextAttemptAt       DateTime?               @map("next_attempt_at")
  receivedAt          DateTime?               @map("received_at")
  sentAt              DateTime?               @map("sent_at")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")
  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channelConnection   ChannelConnection       @relation(fields: [channelConnectionId], references: [id], onDelete: Cascade)
  conversation        Conversation?           @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@unique([channelConnectionId, providerMessageSid])
  @@index([organizationId, channelConnectionId, createdAt])
  @@index([organizationId, status])
  @@index([conversationId])
  @@index([status, nextAttemptAt])
  @@map("channel_messages")
}

